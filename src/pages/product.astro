---
import MainLayout from "../layouts/MainLayout.astro";
import SectionHeader from "../components/common/SectionHeader.astro";
import Button from "../components/common/Button.astro";

const base = import.meta.env.BASE_URL;

const imagePath = `${base}/images/product/product-overview.jpg`;
const loadingVideo = `${base}/media/loading_sequence.mp4`;
const dispensingVideo = `${base}/media/dispensing_sequence.mp4`;
const workflowPage = `${base}/how-it-works/`;
const designPage = `${base}/design/`;

const actors = [
  {
    title: "Patient",
    description:
      "In the app, checks the next scheduled dose and whether it's ready, and reviews dose history against the prescriptions. At the dispenser, picks up each filled pill container.",
  },
  {
    title: "Caregiver",
    description:
      "In the app, enters prescriptions, reviews the combined schedule, and resolves any verification, dispensing, or pickup alerts. At the dispenser, stores the filled pill containers.",
  },
];

const capabilities = [
  {
    title: "Prescription-driven scheduling",
    description:
      "All prescriptions become one combined, editable schedule.",
  },
  {
    title: "Combined dose",
    description:
      "Medications due at the same time share one dose and one pill container.",
  },
  {
    title: "Schedule-driven preparation",
    description:
      "The schedule shows which doses still need a filled container.",
  },
  {
    title: "Container identification",
    description:
      "Each container gets a unique ID at loading, so doses can be loaded in any order.",
  },
  {
    title: "Controlled carousel motion",
    description:
      "The system always know the carousel's position, and exposes a container at Slot L only during loading or pickup.",
  },
  {
    title: "AI verification",
    description:
      "AI checks every container before release and alerts on any mismatch.",
  },
  {
    title: "Safe dispensing",
    description:
      "Only verified containers are made available at Slot L for pickup by the patient.",
  },
  {
    title: "Pickup tracking",
    description:
      "AI confirms each pickup at the next scheduled dose.",
  },
];

const principles = [
  {
    number: "01",
    title: "Prescriptions define every dose",
    description:
      "Each dose's medication types and dispensing time come only from the prescriptions.",
  },
  {
    number: "02",
    title: "One time, one dose, one container",
    description:
      "Medications due at the same time always share one dose and one pill container.",
  },
  {
    number: "03",
    title: "No dispensing without verification",
    description:
      "Every container's contents are verified before it is made available for pickup.",
  },
  {
    number: "04",
    title: "Three IDs define location",
    description:
      "Each container, each carousel position, and the carousel's position in the dispenser has its own ID. A container's location is determined by combining all three.",
  },
  {
    number: "05",
    title: "Know where home is",
    description:
      "The system knows its home position, P1 at Slot L. All carousel locations are measured relative to it.",
  },
  {
    number: "06",
    title: "Pickup is not consumption",
    description:
      "A pickup is never treated as proof the pills have been consumed by the patient.",
  },
  {
    number: "07",
    title: "Isolate failure, continue safely",
    description:
      "One failed container never stops other doses, as long as it is mechanically safe to continue.",
  },
  {
    number: "08",
    title: "Coordination by software",
    description:
      "Every part of the system, from scheduling to alerts, is defined in the product workflows, then implemented and run in software.",
  },
];

const productFacts = [
  {
    value: "12",
    title: "Carrier positions",
    description: "P1 through P12, spaced 30 degrees apart.",
  },
  {
    value: "11",
    title: "Pill containers",
    description: "The maximum at one time, so one position always stays empty.",
  },
  {
    value: "A",
    title: "Inspection slot",
    description: "Slot A is where AI verifies each container's contents.",
  },
  {
    value: "L",
    title: "Load / pickup slot",
    description: "Slot L is used only for loading and pickup by the patient.",
  },
];
---

<MainLayout
  title="Product | MediSAFE: Medication Dispenser"
  description="Explore the users, capabilities, operating model, and product principles behind the medication dispensing prototype with removable containers."
>
  <!-- Hero -->
  <section class="overflow-hidden py-14 sm:py-16 lg:py-20">
    <div
      class="mx-auto grid max-w-[1280px] grid-cols-1 items-center gap-12 px-6 lg:grid-cols-[0.88fr_1.12fr] lg:gap-20 lg:px-10"
    >
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-orange)]">
          Product
        </p>

        <h1 class="mt-5 max-w-[760px] text-3xl font-semibold leading-[1.08] tracking-tight sm:text-4xl lg:text-6xl">
          A medication dispenser with removable pill containers, built for storage and automated dose verification.
        </h1>

        <p class="mt-5 max-w-[680px] sm:mt-6 text-base leading-7 text-[var(--color-text-secondary)] lg:text-lg lg:leading-8">
          The prototype system integrates prescription-based scheduling, dose preparation by a caregiver, AI pill verification, and controlled carousel positioning to provide safe medication dispensing for patients.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={workflowPage}>See How It Works</Button>
          <Button href={designPage} variant="secondary">Explore the Device</Button>
        </div>
      </div>

      <div class="overflow-hidden rounded-[2rem] bg-white p-6 lg:p-10">
        <img
          src={imagePath}
          alt="Medication dispensing device prototype with carousel and removable dose container"
          class="mx-auto w-full"
        />
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="bg-white py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto grid max-w-[1280px] grid-cols-1 gap-12 px-6 lg:grid-cols-[0.62fr_1.38fr] lg:gap-20 lg:px-10">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-orange)]">
          The Problem
        </p>
      </div>

      <div>
        <h2 class="max-w-[900px] text-2xl font-semibold leading-tight sm:text-3xl lg:text-4xl">
          Managing a complex medication regimen is difficult when scheduling, preparation, and verification are done manually.
        </h2>

        <p class="mt-6 max-w-[780px] text-lg leading-8 text-[var(--color-text-secondary)]">
          The product aims to reduce missed and incorrect doses, lessen the caregiver's effort in managing multi-medication schedules, guide the filling of removable containers, and verify their contents.
        </p>

        <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
          <div class="rounded-3xl border border-[var(--color-border)] p-6">
            <p class="text-lg font-semibold">Reduce the risk of dose errors</p>
            <p class="mt-3 leading-7 text-[var(--color-text-secondary)]">
              AI verification is built into the dispensing process; all containers are automatically checked.
            </p>
          </div>

          <div class="rounded-3xl border border-[var(--color-border)] p-6">
            <p class="text-lg font-semibold">Reduce preparation effort</p>
            <p class="mt-3 leading-7 text-[var(--color-text-secondary)]">
              Prescriptions are automatically combined into one schedule that guides the caregiver in filling each pill container.
            </p>
          </div>

          <div class="rounded-3xl border border-[var(--color-border)] p-6">
            <p class="text-lg font-semibold">Provide early warnings</p>
            <p class="mt-3 leading-7 text-[var(--color-text-secondary)]">
              The system automatically tracks preparation readiness, pickup by the patient, and exceptions, alerting the caregiver early.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Users -->
  <section class="py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Users"
        title="Designed around patients and their caregivers."
        description="The product makes it simple for patients to follow their medication regimen, and for their caregivers to manage it, from scheduling to filling each dose."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
        {
          actors.map((actor) => (
            <article class="rounded-3xl border border-[var(--color-border)] bg-white p-8 lg:p-9">
              <h2 class="text-2xl font-semibold">{actor.title}</h2>
              <p class="mt-4 leading-8 text-[var(--color-text-secondary)]">
                {actor.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Product model -->
  <section class="bg-[var(--color-graphite)] py-14 text-white sm:py-16 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Product Model"
        title="Each container’s identity, position, and access are tracked."
        description="Each removable pill container keeps its own ID, so the caregiver can place it in any available carousel position, and the carousel can move it between Slot A and Slot L. This lets the software track each container's position and what is happening to it."
        light
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-3xl bg-white/15 md:grid-cols-2 lg:grid-cols-4">
        {
          productFacts.map((fact) => (
            <article class="bg-[var(--color-graphite)] p-7 lg:p-8">
              <p class="text-4xl font-semibold text-[var(--color-accent-teal)] lg:text-5xl">
                {fact.value}
              </p>
              <h2 class="mt-5 text-lg font-semibold">{fact.title}</h2>
              <p class="mt-3 leading-7 text-white/65">{fact.description}</p>
            </article>
          ))
        }
      </div>

      <p class="mt-8 max-w-[820px] text-base leading-7 text-white/65">
        The carousel is in its home position when P1 is at Slot L. Capacity is measured in doses, not days: the dispenser holds up to eleven prepared doses, and each pill container can hold several medications due at the same time.
      </p>
    </div>
  </section>

  <!-- Compartment motion -->
  <section class="py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Physical Interaction"
        title="See the pill containers in motion."
        description="Pill containers are loaded and picked up only at Slot L. Each container's ID is assigned at loading and stays with it while it's inside the dispenser."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <article class="overflow-hidden rounded-[2rem] border border-[var(--color-border)] bg-white">
          <div class="aspect-video bg-[var(--color-graphite)]">
            <video
              class="viewport-autoplay-video h-full w-full object-cover"
              controls
              muted
              playsinline
              loop
              preload="metadata"
              aria-label="Video showing the loading process of pill containers into the dispenser"
            >
              <source src={loadingVideo} type="video/mp4" />
              Your browser does not support HTML video.
            </video>
          </div>

          <div class="p-7 lg:p-8">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--color-accent-orange)]">
              Loading
            </p>
            <h2 class="mt-3 text-2xl font-semibold">Loading pill containers</h2>
            <p class="mt-4 leading-7 text-[var(--color-text-secondary)]">
              The caregiver inserts a filled pill container through Slot L, and the carousel stores it in an available position until its scheduled dose.
            </p>
          </div>
        </article>

        <article class="overflow-hidden rounded-[2rem] border border-[var(--color-border)] bg-white">
          <div class="aspect-video bg-[var(--color-graphite)]">
            <video
              class="viewport-autoplay-video h-full w-full object-cover"
              controls
              muted
              playsinline
              loop
              preload="metadata"
              aria-label="Video showing the dispensing process of pill containers for pickup"
            >
              <source src={dispensingVideo} type="video/mp4" />
              Your browser does not support HTML video.
            </video>
          </div>

          <div class="p-7 lg:p-8">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--color-accent-orange)]">
              Dispensing
            </p>
            <h2 class="mt-3 text-2xl font-semibold">Dispensing pill containers</h2>
            <p class="mt-4 leading-7 text-[var(--color-text-secondary)]">
              Once AI verifies a container's contents, the carousel positions the container at Slot L, where it is made available for pickup by the patient.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="bg-white py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Product Flow"
        title="A coordinated workflow from doctors' prescriptions to pill pickup by patients."
        description="The dispensing system is more than just a rotating carousel: prescription data, dose scheduling, container preparation, container identification, controlled motion, AI verification, and dose history tracking all work together to manage complex medication regimens."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-3xl border border-[var(--color-border)] bg-[var(--color-border)] md:grid-cols-2 lg:grid-cols-4">
        {
          capabilities.map((capability, index) => (
            <article class="bg-[var(--color-background)] p-7">
              <p class="text-sm font-semibold text-[var(--color-accent-orange)]">
                {String(index + 1).padStart(2, "0")}
              </p>
              <h2 class="mt-4 text-lg font-semibold">{capability.title}</h2>
              <p class="mt-3 leading-7 text-[var(--color-text-secondary)]">
                {capability.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Product Principles"
        title="Eight guiding principles behind every design decision."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          principles.map((principle) => (
            <article class="rounded-3xl border border-[var(--color-border)] bg-white p-7">
              <p class="text-sm font-semibold text-[var(--color-accent-orange)]">
                {principle.number}
              </p>
              <h2 class="mt-5 text-xl font-semibold">{principle.title}</h2>
              <p class="mt-4 leading-7 text-[var(--color-text-secondary)]">
                {principle.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="bg-white py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="rounded-[2rem] border border-[var(--color-border)] p-8 lg:flex lg:items-end lg:justify-between lg:gap-12 lg:p-12">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-orange)]">
            Next
          </p>
          <h2 class="mt-4 max-w-[760px] text-2xl font-semibold leading-tight sm:text-3xl lg:text-4xl">
            Follow the complete medication and device workflow.
          </h2>
          <p class="mt-5 max-w-[720px] text-lg leading-8 text-[var(--color-text-secondary)]">
            See how prescriptions become scheduled doses, how pill containers are filled and verified, and how the carousel moves them from inspection to pickup.
          </p>
        </div>

        <div class="mt-8 shrink-0 lg:mt-0">
          <Button href={workflowPage}>How It Works →</Button>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const videos = document.querySelectorAll(".viewport-autoplay-video");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target;

          if (!(video instanceof HTMLVideoElement)) continue;

          if (entry.isIntersecting) {
            video.play().catch(() => {
              // Manual playback remains available if autoplay is blocked.
            });
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0.6 }
    );

    videos.forEach((video) => observer.observe(video));
  }
</script>
