---
import MainLayout from "../layouts/MainLayout.astro";
import SectionHeader from "../components/common/SectionHeader.astro";
import ResponsiveDiagram from "../components/common/ResponsiveDiagram.astro";

const phases = [
  {
    number: "01",
    title: "Prepare",
    description:
      "The caregiver loads an identified removable compartment with the expected medication and returns it to the carrier.",
  },
  {
    number: "02",
    title: "Inspect",
    description:
      "When the dose becomes due, the carousel moves the assigned compartment to the fixed camera inspection station.",
  },
  {
    number: "03",
    title: "Verify",
    description:
      "The captured medication image is compared with the expected contents before patient access is allowed.",
  },
  {
    number: "04",
    title: "Present",
    description:
      "If verification passes, the same compartment rotates to the patient-accessible hand-off opening.",
  },
  {
    number: "05",
    title: "Confirm",
    description:
      "After the pickup interval, the system determines whether the presented compartment was removed.",
  },
];

const pickupResults = [
  {
    title: "Collected",
    description:
      "Removal is positively confirmed and the compartment becomes unavailable until returned and reloaded.",
  },
  {
    title: "Not Collected",
    description:
      "The pickup interval expires while the compartment remains present.",
  },
  {
    title: "Ambiguous",
    description:
      "The system cannot confidently determine presence or removal and requests user or caregiver resolution.",
  },
];
---

<MainLayout
  title="How It Works | Medicine Dispensing Device"
  description="Follow the medication dispensing workflow from preparation and inspection through verified hand-off, pickup confirmation, and compartment return."
>
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <p
        class="
          text-sm
          font-semibold
          uppercase
          tracking-[0.18em]
          text-[var(--color-accent-orange)]
        "
      >
        How It Works
      </p>

      <h1
        class="
          mt-5
          max-w-[950px]
          text-4xl
          font-semibold
          leading-[1.05]
          tracking-tight
          lg:text-7xl
        "
      >
        From scheduled dose to verified pickup.
      </h1>

      <p
        class="
          mt-7
          max-w-[760px]
          text-lg
          leading-8
          text-[var(--color-text-secondary)]
          lg:text-xl
        "
      >
        Application workflows coordinate scheduling, compartment
        state, carousel movement, medication verification,
        patient hand-off, and pickup confirmation.
      </p>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Dose Journey"
        title="Five phases organize the end-to-end experience."
      />

      <div
        class="
          mt-12
          grid
          grid-cols-1
          gap-4
          lg:grid-cols-5
        "
      >
        {
          phases.map((phase) => (
            <article
              class="
                rounded-3xl
                border
                border-[var(--color-border)]
                bg-[var(--color-background)]
                p-6
              "
            >
              <p
                class="
                  text-sm
                  font-semibold
                  text-[var(--color-accent-orange)]
                "
              >
                {phase.number}
              </p>

              <h2 class="mt-5 text-xl font-semibold">
                {phase.title}
              </h2>

              <p
                class="
                  mt-4
                  text-sm
                  leading-7
                  text-[var(--color-text-secondary)]
                "
              >
                {phase.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Scheduled Presentation Workflow"
        title="Verification determines whether the dose can proceed to hand-off."
        description="The same removable compartment is inspected first and presented only when the configured workflow permits hand-off."
      />

      <div class="mt-12">
        <ResponsiveDiagram
          desktopPath="/images/architecture/desktop/02-scheduled-presentation-workflow.svg"
          mobilePath="/images/architecture/mobile/02-presentation-workflow-mobile.svg"
          alt="Scheduled medication presentation workflow"
        />
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Dose State Model"
        title="The software records progress and exception states explicitly."
      />

      <div class="mt-12">
        <ResponsiveDiagram
          desktopPath="/images/architecture/desktop/03-dose-state-machine.svg"
          mobilePath="/images/architecture/mobile/03-dose-states-mobile.svg"
          alt="Scheduled dose state machine"
        />
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Pickup Verification"
        title="Presentation does not automatically mean collection."
      />

      <div
        class="
          mt-12
          grid
          grid-cols-1
          gap-5
          lg:grid-cols-3
        "
      >
        {
          pickupResults.map((result) => (
            <article
              class="
                rounded-3xl
                border
                border-[var(--color-border)]
                bg-white
                p-7
              "
            >
              <h2 class="text-xl font-semibold">
                {result.title}
              </h2>

              <p
                class="
                  mt-4
                  leading-7
                  text-[var(--color-text-secondary)]
                "
              >
                {result.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Compartment Lifecycle"
        title="Each physical compartment moves through a controlled lifecycle."
        description="The lifecycle is distinct from the scheduled-dose state model because it represents the state of the removable physical container itself."
      />

      <div class="mt-12">
        <ResponsiveDiagram
          desktopPath="/images/architecture/desktop/05-compartment-lifecycle.svg"
          mobilePath="/images/architecture/mobile/05-compartment-lifecycle-mobile.svg"
          alt="Removable compartment lifecycle"
        />
      </div>
    </div>
  </section>
</MainLayout>
