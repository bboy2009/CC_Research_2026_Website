---
import MainLayout from "../layouts/MainLayout.astro";
import SectionHeader from "../components/common/SectionHeader.astro";
import Button from "../components/common/Button.astro";

const base = import.meta.env.BASE_URL;
const loadingVideo = `${base}/media/loading_sequence.mp4`;
const dispensingVideo = `${base}/media/dispensing_sequence.mp4`;
const productPage = `${base}/product/`;
const designPage = `${base}/design/`;

const workflowSteps = [
  {
    number: "01",
    title: "Define the prescription",
    description:
      "The caregiver enters each medication's details: how often and at what times of day it is taken, how many pills to take each time, any start and end dates, and a reference image of the pill for AI to verify against.",
  },
  {
    number: "02",
    title: "Generate the schedule",
    description:
      "The system combines all prescriptions into one editable dispensing schedule. Medications due at the same time are grouped into one dose by default; the caregiver can adjust this as needed.",
  },
  {
    number: "03",
    title: "Prepare the pill container",
    description:
      "The schedule shows which doses have been prepared and which have not. Each dose's details guide the caregiver on exactly which pills go into its pill container.",
  },
  {
    number: "04",
    title: "Load the pill container",
    description:
      "The caregiver inserts the filled container through Slot L, then starts the loading sequence in the app. The system gives the container a unique ID, and the carousel rotates it to Slot A for inspection. If the container passes, the carousel moves it to its storage slot; otherwise, the app alerts the caregiver.",
  },
  {
    number: "05",
    title: "Track time to dispense",
    description:
      "The system monitors the schedule continuously. When a dose is due, the system finds the corresponding container ID and locates its current position in the carousel.",
  },
  {
    number: "06",
    title: "Verify the contents of the pill container",
    description:
      "The carousel places the pill container that is due at Slot A. The camera photographs the container, and AI checks every pill type and count against the scheduled dose.",
  },
  {
    number: "07",
    title: "Place the pill container for pickup",
    description:
      "If verification passes, the carousel positions the container at Slot L, where it is made available for pickup by the patient.",
  },
  {
    number: "08",
    title: "Track pickup",
    description:
      "At the next scheduled dose, AI checks Slot L. If there is no container or the container is empty, pickup is confirmed; an empty container is stored, and the caregiver is alerted. If the container still has pills, it is marked as a failed pickup, stored, and the caregiver is alerted. Either way, the next dispensing sequence then begins.",
  },
];

const pickupResults = [
  {
    title: "Picked up",
    description:
      "At the next scheduled dose, there is no container at Slot L, or the container is empty.",
  },
  {
    title: "Not picked up",
    description:
      "At the next scheduled dose, the container at Slot L still has all its pills. It is marked as a failed pickup and stored, and the caregiver is alerted.",
  },
  {
    title: "Incomplete pickup",
    description:
      "At the next scheduled dose, some pills are left in the container. It is marked as a failed pickup and stored, and the caregiver is alerted and asked to inspect it manually.",
  },
];

const lifecycle = [
  "Available Empty",
  "Loaded",
  "Verified",
  "Due",
  "Positioning",
  "Inspecting",
  "Ready for Pickup",
  "Picked Up",
  "Returned",
  "Error",
];
---

<MainLayout
  title="How It Works | MediSAFE: Medication Dispenser"
  description="Follow the medication dispensing workflow, from prescriptions and container preparation through AI verification, dispensing, and pickup tracking."
>
  <section class="py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-orange)]">
        How It Works
      </p>

      <h1 class="mt-5 max-w-[1000px] text-3xl font-semibold leading-[1.08] tracking-tight sm:text-4xl lg:text-6xl">
        From doctors' prescriptions to pill pickup, step by step.
      </h1>

      <p class="mt-5 max-w-[800px] sm:mt-6 text-base leading-7 text-[var(--color-text-secondary)] lg:text-lg lg:leading-8">
        The system combines prescriptions into one editable schedule, guides the caregiver in filling each pill container, uses AI to verify the contents before dispensing, and tracks pickup by the patient.
      </p>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="End-to-End Workflow"
        title="Eight steps from doctors' prescriptions to medication pickup by the patient."
        description="Data from each step is kept separate by domain: medication information from prescriptions, container IDs, carousel positions, dispenser slots, AI verification results, and pickup data."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          workflowSteps.map((step) => (
            <article class="rounded-3xl border border-[var(--color-border)] bg-[var(--color-background)] p-6 lg:p-7">
              <p class="text-sm font-semibold text-[var(--color-accent-orange)]">
                {step.number}
              </p>
              <h2 class="mt-5 text-xl font-semibold leading-tight">
                {step.title}
              </h2>
              <p class="mt-4 text-sm leading-7 text-[var(--color-text-secondary)]">
                {step.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Physical Sequence"
        title="See loading and dispensing in motion."
        description="Slot L is used only for loading and pickup. Slot A is where AI inspects each pill container, both at loading and before dispensing."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <article class="overflow-hidden rounded-[2rem] border border-[var(--color-border)] bg-white">
          <video
            class="viewport-autoplay-video aspect-video w-full bg-black object-cover"
            controls
            muted
            playsinline
            loop
            preload="metadata"
          >
            <source src={loadingVideo} type="video/mp4" />
            Your browser does not support embedded video.
          </video>

          <div class="p-7 lg:p-8">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-orange)]">
              Loading
            </p>
            <h2 class="mt-3 text-2xl font-semibold">Insert and store a filled pill container.</h2>
            <p class="mt-4 leading-7 text-[var(--color-text-secondary)]">
              The caregiver inserts the filled pill container through Slot L. Once it passes inspection at Slot A, the system records its ID and carousel position, and the carousel rotates it into storage.
            </p>
          </div>
        </article>

        <article class="overflow-hidden rounded-[2rem] border border-[var(--color-border)] bg-white">
          <video
            class="viewport-autoplay-video aspect-video w-full bg-black object-cover"
            controls
            muted
            playsinline
            loop
            preload="metadata"
          >
            <source src={dispensingVideo} type="video/mp4" />
            Your browser does not support embedded video.
          </video>

          <div class="p-7 lg:p-8">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-orange)]">
              Dispensing
            </p>
            <h2 class="mt-3 text-2xl font-semibold">Make the verified pill container available for pickup.</h2>
            <p class="mt-4 leading-7 text-[var(--color-text-secondary)]">
              After the pill container passes inspection at Slot A, the carousel rotates it to Slot L, where it is made available for pickup by the patient.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-16">
        <SectionHeader
          label="Verification Gate"
          title="When verification fails, the dose is held back, but the schedule continues."
          description="Before dispensing, AI compares the pill types and count in the container with the details of the scheduled dose."
        />

        <div class="grid gap-5">
          <article class="rounded-3xl border border-[var(--color-border)] bg-[var(--color-background)] p-7">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-orange)]">
              Verification passes
            </p>
            <h2 class="mt-3 text-xl font-semibold">Continue to position the pill container at Slot L.</h2>
            <p class="mt-3 leading-7 text-[var(--color-text-secondary)]">
              The carousel rotates the same pill container from Slot A, and it is made available for pickup by the patient at Slot L.
            </p>
          </article>

          <article class="rounded-3xl border border-[var(--color-border)] bg-[var(--color-background)] p-7">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-orange)]">
              Verification fails
            </p>
            <h2 class="mt-3 text-xl font-semibold">Hold the dose and return the container to storage.</h2>
            <p class="mt-3 leading-7 text-[var(--color-text-secondary)]">
              The pill container is marked with an error and kept in storage, and the patient and caregiver are alerted. If the system is mechanically safe, other doses continue per schedule.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Pickup Outcome"
        title="Pickup does not mean the pills were consumed."
        description="Dispensing means the verified pill container is made available for pickup by the patient. At the next scheduled dose, AI checks whether it was picked up. Neither dispensing nor pickup proves the pills have been consumed by the patient."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-5 lg:grid-cols-3">
        {
          pickupResults.map((result) => (
            <article class="rounded-3xl border border-[var(--color-border)] bg-white p-7">
              <h2 class="text-xl font-semibold">{result.title}</h2>
              <p class="mt-4 leading-7 text-[var(--color-text-secondary)]">
                {result.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Container Lifecycle"
        title="Each pill container has its own lifecycle."
        description="A container's state is tracked separately from the medication schedule and from the carousel position it occupies."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 flex flex-wrap gap-3">
        {
          lifecycle.map((state, index) => (
            <div class="flex items-center gap-3">
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-background)] px-4 py-2 text-sm font-medium">
                {state}
              </span>
              {index < lifecycle.length - 1 && (
                <span class="hidden text-[var(--color-text-secondary)] sm:inline">→</span>
              )}
            </div>
          ))
        }
      </div>

      <p class="mt-8 max-w-[820px] text-sm leading-7 text-[var(--color-text-secondary)]">
        Error is an exception state, not a required step. A returned container can be refilled and loaded again. Each time, its ID is unique, tied to its scheduled dose, and tracked while the container is inside the dispenser.
      </p>
    </div>
  </section>

  <section class="py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="rounded-[2rem] border border-[var(--color-border)] bg-white p-8 lg:p-12">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-orange)]">
              Explore Further
            </p>
            <h2 class="mt-4 max-w-[780px] text-2xl font-semibold tracking-tight sm:text-3xl lg:text-4xl">
              See how the workflow maps to the physical device.
            </h2>
            <p class="mt-5 max-w-[760px] leading-7 text-[var(--color-text-secondary)]">
              Explore the Product page for the overall product model, or continue to Industrial Design for the dispenser, carousel, and removable pill containers.
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            <Button href={productPage} variant="secondary">Product</Button>
            <Button href={designPage}>Industrial Design</Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const videos = document.querySelectorAll(".viewport-autoplay-video");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target;

          if (!(video instanceof HTMLVideoElement)) continue;

          if (entry.isIntersecting) {
            video.play().catch(() => {
              // Manual playback remains available if autoplay is blocked.
            });
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0.6 }
    );

    videos.forEach((video) => observer.observe(video));
  }
</script>
