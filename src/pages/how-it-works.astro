---
import MainLayout from "../layouts/MainLayout.astro";
import SectionHeader from "../components/common/SectionHeader.astro";
import Button from "../components/common/Button.astro";

const base = import.meta.env.BASE_URL;
const loadingVideo = `${base}/media/loading_sequence.mp4`;
const dispensingVideo = `${base}/media/dispensing_sequence.mp4`;
const productPage = `${base}/product/`;
const designPage = `${base}/design/`;

const workflowSteps = [
  {
    number: "01",
    title: "Define the prescription",
    description:
      "The caregiver defines the medication, dosing instructions, recurrence, timing, and applicable safety limits.",
  },
  {
    number: "02",
    title: "Generate the schedule",
    description:
      "The system generates an editable medication schedule. Medication occurrences due at the exact same time are grouped into one physical dispense event.",
  },
  {
    number: "03",
    title: "Prepare the compartment",
    description:
      "The combined medication and quantity requirements for that dispense event define exactly what should be placed in one removable compartment.",
  },
  {
    number: "04",
    title: "Load through Base Slot L",
    description:
      "The prepared compartment is identified by its persistent C-ID, inserted through Base Slot L, verified where supported, and stored in an available carrier position.",
  },
  {
    number: "05",
    title: "Resolve the compartment when due",
    description:
      "When the dispense event becomes due, the application resolves the assigned C-ID to its current rotating carrier position.",
  },
  {
    number: "06",
    title: "Inspect at Base Slot A",
    description:
      "The target carrier position moves to Base Slot A, where controlled imaging compares the observed medication type and count with the complete expected contents.",
  },
  {
    number: "07",
    title: "Dispense at Base Slot L",
    description:
      "If verification passes, the same physical compartment moves to Base Slot L and is dispensed or ejected from the rotating carrier. Its carrier position then becomes empty.",
  },
  {
    number: "08",
    title: "Resolve pickup separately",
    description:
      "Dispensing records that the compartment has left the carrier. Collection is resolved afterward and is never treated as proof that the medication was ingested.",
  },
];

const pickupResults = [
  {
    title: "Collected",
    description:
      "Available evidence indicates that the dispensed compartment was collected through the patient-access path.",
  },
  {
    title: "Not Collected / Timed Out",
    description:
      "The configured access interval expires without sufficient evidence of collection.",
  },
  {
    title: "Ambiguous Pickup",
    description:
      "Available evidence is insufficient to classify the outcome confidently and requires explicit resolution.",
  },
];

const lifecycle = [
  "Available Empty",
  "Loaded",
  "Verified",
  "Due",
  "Positioning",
  "Inspecting",
  "Ready to Dispense",
  "Dispensed / Removed from Carrier",
  "Returned",
  "Error",
];
---

<MainLayout
  title="How It Works | MediSAFE: Medication Dispenser"
  description="Follow the medicine dispensing workflow from prescription and compartment preparation through verification, dispense, and separate pickup resolution."
>
  <section class="py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-orange)]">
        How It Works
      </p>

      <h1 class="mt-5 max-w-[1000px] text-3xl font-semibold leading-[1.08] tracking-tight sm:text-4xl lg:text-6xl">
        From prescription to verified dispense.
      </h1>

      <p class="mt-5 max-w-[800px] sm:mt-6 text-base leading-7 text-[var(--color-text-secondary)] lg:text-lg lg:leading-8">
        The product turns prescription information into an editable schedule, uses that schedule to guide compartment preparation, verifies the expected medication contents before dispense, and tracks pickup as a separate outcome.
      </p>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="End-to-End Workflow"
        title="Eight steps connect medication planning to physical dispensing."
        description="The workflow keeps medication logic, compartment identity, carrier position, verification, physical dispense, and pickup outcome explicit rather than treating them as one combined state."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          workflowSteps.map((step) => (
            <article class="rounded-3xl border border-[var(--color-border)] bg-[var(--color-background)] p-6 lg:p-7">
              <p class="text-sm font-semibold text-[var(--color-accent-orange)]">
                {step.number}
              </p>
              <h2 class="mt-5 text-xl font-semibold leading-tight">
                {step.title}
              </h2>
              <p class="mt-4 text-sm leading-7 text-[var(--color-text-secondary)]">
                {step.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Physical Sequence"
        title="See loading and dispensing in motion."
        description="Base Slot L is the controlled location used for compartment loading and dispensing. Base Slot A is the primary scheduled medication-inspection location before dispense."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <article class="overflow-hidden rounded-[2rem] border border-[var(--color-border)] bg-white">
          <video
            class="viewport-autoplay-video aspect-video w-full bg-black object-cover"
            controls
            muted
            playsinline
            loop
            preload="metadata"
          >
            <source src={loadingVideo} type="video/mp4" />
            Your browser does not support embedded video.
          </video>

          <div class="p-7 lg:p-8">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-orange)]">
              Loading
            </p>
            <h2 class="mt-3 text-2xl font-semibold">Insert and store a prepared compartment.</h2>
            <p class="mt-4 leading-7 text-[var(--color-text-secondary)]">
              The caregiver inserts the identified compartment through Base Slot L. Once the required checks pass, the system persists its identity and current carrier placement and rotates it into storage.
            </p>
          </div>
        </article>

        <article class="overflow-hidden rounded-[2rem] border border-[var(--color-border)] bg-white">
          <video
            class="viewport-autoplay-video aspect-video w-full bg-black object-cover"
            controls
            muted
            playsinline
            loop
            preload="metadata"
          >
            <source src={dispensingVideo} type="video/mp4" />
            Your browser does not support embedded video.
          </video>

          <div class="p-7 lg:p-8">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-orange)]">
              Dispensing
            </p>
            <h2 class="mt-3 text-2xl font-semibold">Release the verified compartment from the carrier.</h2>
            <p class="mt-4 leading-7 text-[var(--color-text-secondary)]">
              After successful inspection at Base Slot A, the same carrier position moves to Base Slot L. The compartment is dispensed or ejected and that rotating carrier position becomes empty.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-16">
        <SectionHeader
          label="Verification Gate"
          title="A failed inspection blocks that dispense — not the entire device."
          description="Before dispensing, the system compares the complete expected medication-type and quantity set with what is observed in the compartment."
        />

        <div class="grid gap-5">
          <article class="rounded-3xl border border-[var(--color-border)] bg-[var(--color-background)] p-7">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-orange)]">
              Verification passes
            </p>
            <h2 class="mt-3 text-xl font-semibold">Continue to Base Slot L.</h2>
            <p class="mt-3 leading-7 text-[var(--color-text-secondary)]">
              The same physical compartment moves from the inspection location to the dispense location and proceeds to ejection.
            </p>
          </article>

          <article class="rounded-3xl border border-[var(--color-border)] bg-[var(--color-background)] p-7">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-orange)]">
              Verification fails
            </p>
            <h2 class="mt-3 text-xl font-semibold">Block the affected event and retain the compartment.</h2>
            <p class="mt-3 leading-7 text-[var(--color-text-secondary)]">
              The affected compartment can remain installed in an error state while unrelated eligible dispense events may continue when the mechanical state is safe.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Pickup Outcome"
        title="Dispensed does not mean medication was consumed."
        description="A successful dispense means the compartment has left the rotating carrier and is available through the patient-access path. Pickup is tracked separately, and neither dispense nor collection proves ingestion."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-5 lg:grid-cols-3">
        {
          pickupResults.map((result) => (
            <article class="rounded-3xl border border-[var(--color-border)] bg-white p-7">
              <h2 class="text-xl font-semibold">{result.title}</h2>
              <p class="mt-4 leading-7 text-[var(--color-text-secondary)]">
                {result.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Compartment Lifecycle"
        title="The removable compartment has its own lifecycle."
        description="Compartment state is tracked independently from the medication schedule and from the rotating position where the compartment happens to be installed."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 flex flex-wrap gap-3">
        {
          lifecycle.map((state, index) => (
            <div class="flex items-center gap-3">
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-background)] px-4 py-2 text-sm font-medium">
                {state}
              </span>
              {index < lifecycle.length - 1 && (
                <span class="hidden text-[var(--color-text-secondary)] sm:inline">→</span>
              )}
            </div>
          ))
        }
      </div>

      <p class="mt-8 max-w-[820px] text-sm leading-7 text-[var(--color-text-secondary)]">
        Error is an exception state rather than a mandatory linear step. A returned compartment can later be prepared and loaded again while retaining its persistent C-ID.
      </p>
    </div>
  </section>

  <section class="py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="rounded-[2rem] border border-[var(--color-border)] bg-white p-8 lg:p-12">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-orange)]">
              Explore Further
            </p>
            <h2 class="mt-4 max-w-[780px] text-2xl font-semibold tracking-tight sm:text-3xl lg:text-4xl">
              See how the workflow maps to the physical device.
            </h2>
            <p class="mt-5 max-w-[760px] leading-7 text-[var(--color-text-secondary)]">
              Explore the Product page for the overall product model, or continue to Industrial Design for the carrier, removable compartments, inspection location, and dispensing interface.
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            <Button href={productPage} variant="secondary">Product</Button>
            <Button href={designPage}>Industrial Design</Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const videos = document.querySelectorAll(".viewport-autoplay-video");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target;

          if (!(video instanceof HTMLVideoElement)) continue;

          if (entry.isIntersecting) {
            video.play().catch(() => {
              // Manual playback remains available if autoplay is blocked.
            });
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0.6 }
    );

    videos.forEach((video) => observer.observe(video));
  }
</script>
