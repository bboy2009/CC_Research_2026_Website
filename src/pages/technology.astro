---
import MainLayout from "../layouts/MainLayout.astro";
import SectionHeader from "../components/common/SectionHeader.astro";
import Button from "../components/common/Button.astro";
import ResponsiveDiagram from "../components/common/ResponsiveDiagram.astro";

const base = import.meta.env.BASE_URL;
const visionPage = `${base}/vision/`;
const howItWorksPage = `${base}/how-it-works/`;

const desktopLight = `${base}/images/software/design_m4_01.jpg`;
const desktopDark = `${base}/images/software/design_m4_02.jpg`;
const mobileLight = `${base}/images/software/design_m4_03.jpg`;

const workflowServices = [
  "Medication & Prescription",
  "Scheduler & Event Aggregation",
  "Preparation Planning",
  "Compartment & Placement",
  "Scheduled Dispense",
  "Pickup Resolution",
  "Alerts & Audit",
];

const ports = [
  {
    name: "DevicePort",
    description: "Mechanical commands, pose, safety state, load/eject status, lighting, and recovery.",
  },
  {
    name: "CameraPort",
    description: "Image acquisition behind a replaceable camera implementation.",
  },
  {
    name: "VisionPort",
    description: "Expected-vs-observed medication verification with explicit result states.",
  },
  {
    name: "ClockPort",
    description: "Trusted wall time for production and deterministic time for simulation and testing.",
  },
  {
    name: "NotificationPort",
    description: "User-facing alerts and notification delivery behind an application boundary.",
  },
];

const firmwareResponsibilities = [
  "HOME with P1 aligned to Base Slot L",
  "Indexed movement between carrier positions and Base Slots",
  "One-index CW and CCW motion",
  "Local motion and ejection interlocks",
  "Illumination control",
  "Physical pose, status, and fault reporting",
];

const firmwareDoesNotOwn = [
  "Prescription or scheduling decisions",
  "Medication-content correctness",
  "Compartment C-ID semantics",
  "Pickup or adherence outcome",
];

const dataEntities = [
  "Medication",
  "Prescription",
  "Schedule",
  "MedicationOccurrence",
  "DeviceDispenseEvent",
  "DispenseItem",
  "CompartmentPreparationPlan",
  "RemovableCompartment",
  "CompartmentPlacement",
  "CarouselPose",
  "InspectionEvent",
  "DispenseEvent",
  "PickupEvent",
  "Alert / SystemEvent",
];
---

<MainLayout
  title="Technology & Architecture | MediSAFE: Medication Dispenser"
  description="Explore the software UI, application workflows, APIs, ports and adapters, local persistence, computer vision, simulation, and embedded-control architecture of the medicine dispensing prototype."
>
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-orange)]">
        Technology & Architecture
      </p>

      <h1 class="mt-5 max-w-[1050px] text-3xl font-semibold leading-[1.08] tracking-tight sm:text-4xl lg:text-6xl">
        Software coordinates the medication workflow. Embedded control owns deterministic motion.
      </h1>

      <p class="mt-7 max-w-[860px] text-base leading-7 text-[var(--color-text-secondary)] lg:text-lg lg:leading-8">
        The system separates medication-domain decisions from physical execution. A browser interface communicates through FastAPI to application workflows, which use explicit ports for device, camera, vision, time, and notifications while local device firmware handles motion, interlocks, illumination, and hardware state.
      </p>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[0.68fr_1.32fr] lg:items-end lg:gap-16">
        <div>
          <SectionHeader
            label="Software Experience"
            title="The software UI is the operational view of the complete system."
            description="The interface brings carousel state, upcoming dispense events, alerts, prescriptions, preparation status, calendar state, and direct prototype controls into a summary-first experience."
          />
        </div>

        <p class="max-w-[580px] text-base leading-7 text-[var(--color-text-secondary)] lg:justify-self-end">
          The desktop view exposes more system detail at once, while the responsive mobile view preserves the same core workflow for smaller screens. Light and dark appearance modes support different viewing environments.
        </p>
      </div>

      <div class="mt-10 flex justify-start lg:justify-end">
        <div
          class="inline-flex rounded-full border border-[var(--color-border)] bg-[var(--color-background)] p-1"
          role="group"
          aria-label="Desktop interface appearance"
        >
          <button
            type="button"
            class="software-theme-toggle rounded-full bg-[var(--color-graphite)] px-5 py-2 text-sm font-semibold text-white transition-colors"
            data-software-theme="light"
            aria-pressed="true"
          >
            Light
          </button>
          <button
            type="button"
            class="software-theme-toggle rounded-full px-5 py-2 text-sm font-semibold text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]"
            data-software-theme="dark"
            aria-pressed="false"
          >
            Dark
          </button>
        </div>
      </div>

      <div class="relative mt-6 pb-24 sm:pb-32 lg:mt-8 lg:pb-40">
        <div class="overflow-hidden rounded-[1.75rem] border border-[var(--color-border)] bg-white p-2 shadow-[0_24px_80px_rgba(34,34,34,0.12)] lg:rounded-[2rem] lg:p-3">
          <div class="mb-2 flex items-center gap-2 px-3 py-2 lg:mb-3">
            <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-border)]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-border)]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-border)]"></span>
            <span
              id="software-theme-label"
              class="ml-2 text-xs font-medium uppercase tracking-[0.12em] text-[var(--color-text-secondary)]"
            >
              Desktop interface · Light mode
            </span>
          </div>

          <img
            id="software-desktop-preview"
            src={desktopLight}
            data-light-src={desktopLight}
            data-dark-src={desktopDark}
            alt="Desktop medicine dispenser software interface in light mode showing carousel status, scheduled dose, alerts, prescriptions, calendar, and device controls"
            loading="eager"
            class="w-full rounded-[1.25rem]"
          />
        </div>

        <div class="absolute bottom-0 right-3 w-[38%] min-w-[150px] max-w-[330px] overflow-hidden rounded-[1.75rem] border-[6px] border-white bg-white shadow-[0_20px_60px_rgba(34,34,34,0.22)] sm:right-8 lg:right-12 lg:border-[8px]">
          <img
            src={mobileLight}
            alt="Responsive mobile version of the medicine dispenser software interface"
            loading="lazy"
            class="w-full"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="System Architecture"
        title="From browser interaction to motor, sensors, and lighting."
        description="The layered system architecture keeps high-level medication decisions in the application while hardware-specific timing, sensing, and interlocks remain under embedded control."
      />

      <div class="mt-12">
        <ResponsiveDiagram
          desktopPath="/images/architecture/desktop/01-layered-system-architecture.svg"
          mobilePath="/images/architecture/mobile/01-layers-mobile.svg"
          alt="Layered system architecture for the medicine dispensing device"
          caption="The same system layers are presented at different information densities for desktop and mobile viewing."
          eager={true}
        />
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Application Layer"
        title="Workflows own medication and product decisions."
        description="The application coordinates scheduling, preparation, compartment placement, verification, physical dispense, pickup resolution, alerts, and audit while keeping hardware-specific details behind ports and adapters."
      />

      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {workflowServices.map((service, index) => (
          <article class="rounded-3xl border border-[var(--color-border)] bg-[var(--color-background)] p-7">
            <p class="text-sm font-semibold text-[var(--color-accent-orange)]">{String(index + 1).padStart(2, "0")}</p>
            <h2 class="mt-4 text-xl font-semibold">{service}</h2>
          </article>
        ))}
      </div>

      <div class="mt-10 rounded-3xl border border-[var(--color-border)] bg-[var(--color-background)] p-7 lg:p-9">
        <p class="text-lg font-semibold">Important boundary</p>
        <p class="mt-3 max-w-[900px] leading-7 text-[var(--color-text-secondary)]">
          The scheduler creates medication occurrences and device dispense events, but it does not directly command motors. Hardware movement happens only through application workflows and the device abstraction after the required product and safety checks are satisfied.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Ports & Adapters"
        title="Hardware and providers remain replaceable behind explicit interfaces."
        description="The same application workflows can run with simulated adapters during development and physical adapters during integration, reducing coupling between product logic and specific devices or providers."
      />

      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {ports.map((port) => (
          <article class="rounded-3xl border border-[var(--color-border)] bg-white p-7">
            <code class="text-sm font-semibold text-[var(--color-accent-orange)]">{port.name}</code>
            <p class="mt-4 leading-7 text-[var(--color-text-secondary)]">{port.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Interface Boundaries"
        title="Data and commands move through explicit interfaces."
        description="The interface control map shows how the browser UI, application workflows, services, camera, embedded controller, and physical hardware exchange data and commands while keeping responsibilities separated."
      />

      <div class="mt-12">
        <ResponsiveDiagram
          desktopPath="/images/architecture/desktop/06-interface-control-map.svg"
          mobilePath="/images/architecture/mobile/06-interfaces-mobile.svg"
          alt="Interface control map for the medicine dispensing device"
          caption="The interface map highlights the boundaries between the browser, application workflows, software services, device adapters, embedded control, and physical hardware."
        />
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-28">
    <div class="mx-auto grid max-w-[1280px] grid-cols-1 gap-12 px-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:gap-20 lg:px-10">
      <div>
        <SectionHeader
          label="Computer Vision"
          title="Vision provides evidence to the workflow — not direct motor control."
          description="For inspection, the application provides the expected combined medication set and receives an explicit verification outcome. Time-critical physical interlocks remain local to the device rather than depending on cloud vision."
        />

        <div class="mt-8">
          <Button href={visionPage} variant="secondary">Explore Computer Vision →</Button>
        </div>
      </div>

      <div class="rounded-[2rem] bg-[var(--color-graphite)] p-7 text-white lg:p-10">
        {["Expected medication set", "Camera image", "VisionPort", "MATCH / MISMATCH / UNKNOWN / error outcome", "Application workflow decision"].map((item, index, array) => (
          <div>
            <div class="rounded-2xl bg-white/10 px-6 py-5 text-center">{item}</div>
            {index < array.length - 1 && <div class="py-2 text-center text-white/30">↓</div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Embedded Controller"
        title="Firmware owns deterministic physical execution and local safety."
        description="The embedded state model makes startup, homing, indexed movement, controlled access/ejection, and fault recovery explicit. Medication-domain decisions remain outside firmware."
      />

      <div class="mt-12">
        <ResponsiveDiagram
          desktopPath="/images/architecture/desktop/04-embedded-controller-states.svg"
          mobilePath="/images/architecture/mobile/04-firmware-states-mobile.svg"
          alt="Embedded controller state diagram for the medicine dispensing device"
          caption="The embedded controller state machine separates physical initialization, homing, ready state, motion, controlled access/ejection, and fault recovery."
        />
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <article class="rounded-3xl border border-[var(--color-border)] bg-white p-8">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-orange)]">Firmware owns</p>
          <div class="mt-6 grid gap-3">
            {firmwareResponsibilities.map((item) => (
              <div class="rounded-2xl bg-[var(--color-background)] px-5 py-4 text-sm leading-6">{item}</div>
            ))}
          </div>
        </article>

        <article class="rounded-3xl border border-[var(--color-border)] bg-white p-8">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-orange)]">Firmware does not decide</p>
          <div class="mt-6 grid gap-3">
            {firmwareDoesNotOwn.map((item) => (
              <div class="rounded-2xl bg-[var(--color-background)] px-5 py-4 text-sm leading-6">{item}</div>
            ))}
          </div>

          <div class="mt-8 rounded-2xl bg-[var(--color-graphite)] p-6 text-white">
            <p class="font-semibold">Mechanical reference</p>
            <p class="mt-2 text-sm leading-6 text-white/70">HOME establishes P1 aligned with Base Slot L. From that reference, the controller maintains a discrete indexed pose and supports deterministic one-index CW / CCW movement.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Domain Model"
        title="Scheduling, physical state, evidence, and operations remain explicit."
        description="The domain model separates medications and prescriptions from concrete dispense events, compartment identity and placement, inspection evidence, physical dispense, pickup outcome, alerts, and audit history."
      />

      <div class="mt-12">
        <ResponsiveDiagram
          desktopPath="/images/architecture/desktop/07-domain-model.svg"
          mobilePath="/images/architecture/mobile/07-domain-model-mobile.svg"
          alt="Domain model for the medicine dispensing application"
          caption="The domain model shows how schedule, compartment, inspection, dispense, pickup, and system-event records remain separate while participating in the same product workflow."
        />
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        {dataEntities.map((entity) => (
          <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-background)] px-4 py-2 text-sm font-medium">{entity}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Persistence"
        title="Product state is stored as separate, explicit records."
        description="Medication scheduling, physical compartment identity, placement, carousel pose, inspection, dispense, pickup, and alerts remain separate so one physical action cannot silently imply another product state."
      />

      <p class="mt-8 max-w-[880px] text-sm leading-7 text-[var(--color-text-secondary)]">
        SQLite provides local persistence with foreign keys, versioned migrations, and transactional workflow updates. In-memory carousel pose is represented relative to the HOME reference so automatic operation can reconcile physical and persisted state after startup or uncertainty.
      </p>
    </div>
  </section>

  <section class="bg-[var(--color-graphite)] py-16 text-white lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-16">
        <SectionHeader
          label="Testing & Simulation"
          title="The same workflows can run without the physical device."
          description="Simulated adapters model carrier positions, Base Slots, HOME, indexed motion, loading, ejection, compartment placement, verification failures, grouped dispense events, and time. This enables deterministic replay before hardware integration."
          light={true}
        />

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-3xl bg-white/10 p-6">
            <p class="font-semibold">Simulated environment</p>
            <p class="mt-3 text-sm leading-6 text-white/65">Exercise scheduling, preparation, motion, faults, and UI state deterministically.</p>
          </div>
          <div class="rounded-3xl bg-white/10 p-6">
            <p class="font-semibold">Physical environment</p>
            <p class="mt-3 text-sm leading-6 text-white/65">Swap in production adapters while preserving the application workflow.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="rounded-[2rem] border border-[var(--color-border)] bg-white p-8 lg:flex lg:items-end lg:justify-between lg:gap-12 lg:p-12">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-orange)]">Next</p>
          <h2 class="mt-4 max-w-[760px] text-2xl font-semibold leading-tight sm:text-3xl lg:text-4xl">See the architecture operating as a complete workflow.</h2>
          <p class="mt-5 max-w-[720px] text-lg leading-8 text-[var(--color-text-secondary)]">Follow prescription generation, compartment preparation, inspection, physical dispensing, and pickup resolution from end to end.</p>
        </div>
        <div class="mt-8 shrink-0 lg:mt-0">
          <Button href={howItWorksPage}>How It Works →</Button>
        </div>
      </div>
    </div>
  </section>
</MainLayout>


<script>
  const desktopPreview = document.querySelector("#software-desktop-preview");
  const themeLabel = document.querySelector("#software-theme-label");
  const themeButtons = document.querySelectorAll(".software-theme-toggle");

  if (desktopPreview instanceof HTMLImageElement) {
    const setSoftwareTheme = (theme) => {
      const isDark = theme === "dark";
      const nextSrc = isDark
        ? desktopPreview.dataset.darkSrc
        : desktopPreview.dataset.lightSrc;

      if (nextSrc) {
        desktopPreview.src = nextSrc;
      }

      desktopPreview.alt = `Desktop medicine dispenser software interface in ${theme} mode showing carousel status, scheduled dose, alerts, prescriptions, calendar, and device controls`;

      if (themeLabel) {
        themeLabel.textContent = `Desktop interface · ${isDark ? "Dark" : "Light"} mode`;
      }

      themeButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;

        const isActive = button.dataset.softwareTheme === theme;
        button.setAttribute("aria-pressed", String(isActive));
        button.classList.toggle("bg-[var(--color-graphite)]", isActive);
        button.classList.toggle("text-white", isActive);
        button.classList.toggle("text-[var(--color-text-secondary)]", !isActive);
      });
    };

    themeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!(button instanceof HTMLButtonElement)) return;
        setSoftwareTheme(button.dataset.softwareTheme === "dark" ? "dark" : "light");
      });
    });
  }
</script>
