---
import MainLayout from "../layouts/MainLayout.astro";
import SectionHeader from "../components/common/SectionHeader.astro";
import Button from "../components/common/Button.astro";
import ResponsiveDiagram from "../components/common/ResponsiveDiagram.astro";

const base = import.meta.env.BASE_URL;
const visionPage = `${base}/vision/`;

const responsibilities = [
  {
    title: "Application Workflows",
    description:
      "Coordinate multi-step dose operations and keep scheduling, vision, persistence, notifications, and hardware responsibilities separated.",
  },
  {
    title: "Vision Service",
    description:
      "Returns medication identity, count, confidence, geometry or annotation data, and compartment presence information where available.",
  },
  {
    title: "Device Service",
    description:
      "Provides the application-facing boundary for serial commands, device status, homing, motion, lighting, and recovery operations.",
  },
  {
    title: "Embedded Controller",
    description:
      "Owns deterministic motor control, sensors, illumination, homing behavior, interlocks, and hardware fault responses.",
  },
];

const deviceCommands = [
  "HOME",
  "MOVE_TO_INSPECTION",
  "MOVE_TO_HANDOFF",
  "LIGHT_ON",
  "LIGHT_OFF",
  "GET_STATUS",
  "RESET / RECOVER",
];
---

<MainLayout
  title="Technology & Architecture | Medicine Dispensing Device"
  description="Explore the application, computer-vision, device-service, embedded-controller, interface, state, and persistence architecture of the medicine dispensing prototype."
>
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <p
        class="
          text-sm
          font-semibold
          uppercase
          tracking-[0.18em]
          text-[var(--color-accent-orange)]
        "
      >
        Technology & Architecture
      </p>

      <h1
        class="
          mt-5
          max-w-[1000px]
          text-4xl
          font-semibold
          leading-[1.05]
          tracking-tight
          lg:text-7xl
        "
      >
        Clear boundaries between application decisions and physical control.
      </h1>

      <p
        class="
          mt-7
          max-w-[800px]
          text-lg
          leading-8
          text-[var(--color-text-secondary)]
          lg:text-xl
        "
      >
        The system is organized around a modular application layer,
        replaceable camera and device adapters, a Vision Service,
        local persistence, and a separate embedded controller responsible
        for deterministic hardware execution.
      </p>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="System Architecture"
        title="From browser interaction to motor, sensors, and lighting."
        description="The architecture keeps high-level medication decisions in the application while hardware-specific timing and interlocks remain under embedded control."
      />

      <div class="mt-12">
        <ResponsiveDiagram
          desktopPath="/images/architecture/desktop/01-layered-system-architecture.svg"
          mobilePath="/images/architecture/mobile/01-layers-mobile.svg"
          alt="Layered system architecture for the medicine dispensing device"
          caption="Desktop and mobile versions present the same architectural boundary at different information densities."
          eager={true}
        />
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Responsibilities"
        title="Subsystems have distinct ownership."
      />

      <div
        class="
          mt-12
          grid
          grid-cols-1
          gap-5
          lg:grid-cols-2
        "
      >
        {
          responsibilities.map((item) => (
            <article
              class="
                rounded-3xl
                border
                border-[var(--color-border)]
                bg-white
                p-7
                lg:p-8
              "
            >
              <h2 class="text-xl font-semibold">{item.title}</h2>
              <p
                class="
                  mt-4
                  leading-7
                  text-[var(--color-text-secondary)]
                "
              >
                {item.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Interface Boundaries"
        title="Data and commands move through explicit interfaces."
        description="The control map documents producer-to-consumer boundaries across the browser, application workflows, services, camera, firmware, and sensors."
      />

      <div class="mt-12">
        <ResponsiveDiagram
          desktopPath="/images/architecture/desktop/06-interface-control-map.svg"
          mobilePath="/images/architecture/mobile/06-interfaces-mobile.svg"
          alt="Interface control map for the medicine dispensing device"
        />
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-28">
    <div
      class="
        mx-auto
        grid
        max-w-[1280px]
        grid-cols-1
        gap-12
        px-6
        lg:grid-cols-[0.8fr_1.2fr]
        lg:items-start
        lg:gap-20
        lg:px-10
      "
    >
      <div>
        <SectionHeader
          label="Computer Vision"
          title="Visual inspection is an application service, not a motor-control responsibility."
          description="Vision provides evidence that application workflows can compare with the expected scheduled dose before a compartment is made available to the patient."
        />

        <div class="mt-8">
          <Button href={visionPage} variant="secondary">
            View Interim Vision Results →
          </Button>
        </div>
      </div>

      <div
        class="
          rounded-[2rem]
          bg-[var(--color-graphite)]
          p-7
          text-white
          lg:p-10
        "
      >
        {
          [
            "Camera image",
            "Vision Service",
            "Identity + count + confidence",
            "Expected vs detected",
            "Workflow decision",
          ].map((item, index, array) => (
            <div>
              <div class="rounded-2xl bg-white/10 px-6 py-5 text-center">
                {item}
              </div>
              {
                index < array.length - 1 && (
                  <div class="py-2 text-center text-white/30">↓</div>
                )
              }
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Embedded Controller"
        title="Firmware owns deterministic physical execution."
        description="The embedded controller handles homing, indexed movement, hand-off waiting, sensor and interlock behavior, illumination, and hardware fault states."
      />

      <div class="mt-12">
        <ResponsiveDiagram
          desktopPath="/images/architecture/desktop/04-embedded-controller-states.svg"
          mobilePath="/images/architecture/mobile/04-firmware-states-mobile.svg"
          alt="Embedded controller state diagram for the medicine dispensing device"
        />
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        {
          deviceCommands.map((command) => (
            <code
              class="
                rounded-full
                bg-[var(--color-graphite)]
                px-4
                py-2
                text-sm
                text-white
              "
            >
              {command}
            </code>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Domain Model"
        title="Scheduling, physical state, evidence, and operations remain explicit."
        description="Persistent entities represent planned doses, removable compartments, medication assignments, inspection and pickup evidence, alerts, and system events."
      />

      <div class="mt-12">
        <ResponsiveDiagram
          desktopPath="/images/architecture/desktop/07-domain-model.svg"
          mobilePath="/images/architecture/mobile/07-domain-model-mobile.svg"
          alt="Domain model for the medicine dispensing application"
        />
      </div>
    </div>
  </section>

  <section
    class="
      bg-[var(--color-graphite)]
      py-16
      text-white
      lg:py-28
    "
  >
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Testing & Simulation"
        title="Application workflows can be exercised without physical hardware."
        description="Replaceable Device and Camera adapters allow the same application workflows to run with simulated hardware during development and with physical hardware as integration progresses."
        light={true}
      />
    </div>
  </section>
</MainLayout>
