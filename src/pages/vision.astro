---
import MainLayout from "../layouts/MainLayout.astro";
import SectionHeader from "../components/common/SectionHeader.astro";
import Button from "../components/common/Button.astro";
import VisionResultCard from "../components/vision/VisionResultCard.astro";

const base = import.meta.env.BASE_URL;
const technologyPage = `${base}/technology/`;
const researchPage = `${base}/research/`;
const workflowPage = `${base}/how-it-works/`;

const inspectionLocations = [
  {
    location: "Slot A",
    purpose: "Content verification",
    description:
      "The carousel places each container at Slot A twice: at loading, before it goes into storage, and again before it is made available for pickup. Each time, its contents are checked against its dose details.",
  },
  {
    location: "Slot L",
    purpose: "Pickup verification",
    description:
      "At the next scheduled dose, AI checks Slot L. Pickup is confirmed if there is no container, or if the container is empty, in which case it is marked empty and stored.",
  },
];

const pipeline = [
  {
    number: "01",
    title: "Provide the expected result",
    description:
      "The backend application provides the dose details: the medication types and the quantity of each. For pickup verification, the expected result is no container or an empty container.",
  },
  {
    number: "02",
    title: "Capture the container image",
    description:
      "A single, fixed camera covers both Slot A and Slot L under controlled lighting, and a computer vision package optimizes the captured images.",
  },
  {
    number: "03",
    title: "Identify the contents",
    description:
      "If any pills appear in the image, multimodal AI models outline each pill, identify its type with a confidence score, and count the total.",
  },
  {
    number: "04",
    title: "Compare actual and expected results",
    description:
      "The identified pill types and counts are compared with the expected outcome for that verification.",
  },
  {
    number: "05",
    title: "Return the verification result",
    description:
      "The AI service sends a summary result, with supporting evidence, back to the backend application, which decides on and coordinates the next steps.",
  },
];

const outcomes = [
  {
    name: "MATCH",
    meaning: "The identified contents match the expected outcome.",
  },
  {
    name: "MISMATCH",
    meaning: "The identified pill type or count does not match the expected outcome.",
  },
  {
    name: "UNKNOWN",
    meaning: "The contents cannot be identified with enough confidence.",
  },
  {
    name: "AMBIGUOUS",
    meaning: "Available evidence supports more than one plausible interpretation.",
  },
  {
    name: "VISION_UNAVAILABLE",
    meaning: "The AI vision service is unavailable for this verification.",
  },
  {
    name: "TIMEOUT",
    meaning: "The verification did not finish within the allowed time.",
  },
  {
    name: "PROVIDER_ERROR",
    meaning: "The AI service or provider returned an error.",
  },
  {
    name: "PROTOCOL_ERROR",
    meaning: "The backend application could not read the AI response as a valid verification result.",
  },
];

const results = [
  {
    imagePath: "/images/vision/interim-results/pill-a-01-annotated.jpg",
    label: "Interim Result 01",
    title: "Single-object inspection",
    description:
      "A single pill is identified as PILL_A and outlined in the inspection image.",
    details: [
      "One annotated detection is visible.",
      "The displayed model confidence is 99%.",
      "This image demonstrates object localization and pill-type labeling in a simple scene.",
    ],
  },
  {
    imagePath: "/images/vision/interim-results/pill-b-01-annotated.jpg",
    label: "Interim Result 02",
    title: "Single-object inspection — PILL_B",
    description:
      "A single white pill is identified as PILL_B and outlined in the inspection image.",
    details: [
      "One annotated detection is visible.",
      "The displayed model confidence is 99%.",
      "This image provides a second simple-scene example using a visually different configured pill type.",
    ],
  },
  {
    imagePath: "/images/vision/interim-results/mixed-pills-01-annotated.jpg",
    label: "Interim Result 03",
    title: "Mixed pill types",
    description:
      "Three visually different pills are annotated in the same container image.",
    details: [
      "Three detections are visible across PILL_A, PILL_B, and PILL_C labels.",
      "Each displayed model confidence is 99%.",
      "This image demonstrates multiple classes and different object sizes within one field of view.",
    ],
  },
  {
    imagePath: "/images/vision/interim-results/mixed-pills-02-annotated.jpg",
    label: "Interim Result 04",
    title: "Crowded multi-object inspection",
    description:
      "A more crowded image contains multiple pill types, orientations, sizes, and closely spaced objects.",
    details: [
      "Nine annotated detections are visible.",
      "Displayed model confidences range from 98% to 99%.",
      "This image is useful for evaluating behavior in a more complex scene, including close and partially touching objects.",
    ],
  },
];
---

<MainLayout
  title="Computer Vision | MediSAFE: Medication Dispenser"
  description="Explore how MediSAFE uses AI vision to verify each pill container at loading and before pickup."
>
  <section class="py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-orange)]">
        Computer Vision
      </p>

      <h1 class="mt-5 max-w-[1000px] text-3xl font-semibold leading-[1.08] tracking-tight sm:text-4xl lg:text-6xl">
        AI verification of every dose, at loading and before pickup.
      </h1>

      <p class="mt-5 max-w-[840px] sm:mt-6 text-base leading-7 text-[var(--color-text-secondary)] lg:text-lg lg:leading-8">
        OpenCV optimizes each image from a single camera, then OpenAI models outline each pill, identify it with a confidence score, and count the total. The result is compared with the details of the scheduled dose, at loading and again before the container is made available for pickup.
      </p>

      <div class="mt-8 max-w-[900px] rounded-2xl border border-[var(--color-border)] bg-white p-5">
        <p class="font-semibold">Development evidence, not clinical validation</p>
        <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">
          The annotated images on this page are interim development outputs. Confidence values are the AI model's own per-pill scores, not measured end-to-end system accuracy or a completed validation result.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Role in the Product"
        title="AI checks each container at two slots."
        description="Contents are verified at Slot A, and pickup is confirmed at Slot L."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
        {
          inspectionLocations.map((item) => (
            <article class="rounded-3xl border border-[var(--color-border)] bg-[var(--color-background)] p-8">
              <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-orange)]">
                {item.location}
              </p>
              <h2 class="mt-3 text-2xl font-semibold">{item.purpose}</h2>
              <p class="mt-4 leading-7 text-[var(--color-text-secondary)]">
                {item.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Verification Flow"
        title="Verification passes when the container contents match the expected result."
        description="The backend application coordinates verification using the camera and the AI services. The camera captures the images the AI service uses to identify and count the pills. Using the target dose's details, the AI service returns the evidence and the comparison result."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-5">
        {
          pipeline.map((step) => (
            <article class="rounded-3xl border border-[var(--color-border)] bg-white p-6">
              <p class="text-sm font-semibold text-[var(--color-accent-orange)]">{step.number}</p>
              <h2 class="mt-5 text-xl font-semibold">{step.title}</h2>
              <p class="mt-4 text-sm leading-7 text-[var(--color-text-secondary)]">
                {step.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-graphite)] py-14 text-white sm:py-16 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Explicit Verification Results"
        title="Verification results go beyond pass or fail: each failure is classified by its root cause."
        description="Going beyond a binary outcome lets the backend application tell apart a true content mismatch, an uncertain result, a failure to reach the AI service, a timeout while waiting for its answer, an error returned by the AI service, and a communication protocol error."
        light={true}
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          outcomes.map((outcome) => (
            <article class="rounded-3xl bg-white/10 p-6">
              <code class="text-sm font-semibold text-[var(--color-accent-teal)]">{outcome.name}</code>
              <p class="mt-3 text-sm leading-6 text-white/70">{outcome.meaning}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:gap-16">
        <SectionHeader
          label="Workflow Decision"
          title="Verification results gate dose availability for pickup."
          description="The backend application uses the verification result to decide the next step. A successful verification lets the container move to Slot L for pickup. A failed verification holds the dose, marks the container with an error, and alerts the patient and caregiver, while other doses continue per schedule."
        />

        <div class="grid gap-5">
          <article class="rounded-3xl border border-[var(--color-border)] bg-white p-7">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-orange)]">MATCH</p>
            <h2 class="mt-3 text-xl font-semibold">Continue the scheduled workflow.</h2>
            <p class="mt-3 leading-7 text-[var(--color-text-secondary)]">
              The verified container moves from Slot A to Slot L, where it is made available for pickup by the patient.
            </p>
          </article>

          <article class="rounded-3xl border border-[var(--color-border)] bg-white p-7">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-orange)]">Non-match / unresolved result</p>
            <h2 class="mt-3 text-xl font-semibold">Hold the dose and return the container to storage.</h2>
            <p class="mt-3 leading-7 text-[var(--color-text-secondary)]">
              The dose is held, and the container is marked with an error and returned to storage. A failed verification affects only that dose; other doses continue when it is mechanically safe.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Current Development Evidence"
        title="Increasing scene complexity across four inspection examples."
        description="These images show current annotation behavior, not completed testing. Formal validation requires a controlled labeled dataset, defined acceptance metrics, and repeatable test conditions."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 space-y-8">
        {results.map((result) => <VisionResultCard {...result} />)}
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto grid max-w-[1280px] grid-cols-1 gap-12 px-6 lg:grid-cols-2 lg:gap-20 lg:px-10">
      <div>
        <SectionHeader label="What This Demonstrates" title="Observable development evidence." />
        <ul class="mt-8 space-y-4 leading-7 text-[var(--color-text-secondary)]">
          <li>• Multiple pills are outlined and identified in one container image.</li>
          <li>• Different configured pill-type labels can appear in the same scene.</li>
          <li>• Each pill is shown with a visible outline.</li>
          <li>• Each pill's identification includes a confidence score.</li>
        </ul>
      </div>

      <div>
        <SectionHeader label="What Remains To Validate" title="A production verification policy needs measured evidence." />
        <ul class="mt-8 space-y-4 leading-7 text-[var(--color-text-secondary)]">
          <li>• Detection and classification performance across a controlled labeled dataset.</li>
          <li>• Robustness to lighting, orientation, reflections, touching pills, and occlusion.</li>
          <li>• Count accuracy and false-positive / false-negative behavior.</li>
          <li>• Acceptance thresholds and handling of unresolved verification results.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="rounded-[2rem] border border-[var(--color-border)] bg-[var(--color-background)] p-8 lg:p-12">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--color-accent-orange)]">Safety Boundary</p>
            <h2 class="mt-4 text-2xl font-semibold tracking-tight lg:text-3xl">AI vision verifies container contents; it does not handle time-critical physical safety.</h2>
          </div>

          <p class="leading-8 text-[var(--color-text-secondary)]">
            Local hardware interlocks, carousel position, and unsafe motion or access conditions stay with the embedded device layer. A cloud-based AI service must never be used to enforce time-critical physical safety.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-graphite)] py-14 text-white sm:py-16 lg:py-20">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-8 px-6 lg:flex-row lg:items-end lg:justify-between lg:px-10">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-teal)]">Continue Exploring</p>
        <h2 class="mt-4 max-w-[760px] text-2xl font-semibold sm:text-3xl lg:text-4xl">
          See vision in the complete workflow, architecture, and research program.
        </h2>
      </div>

      <div class="flex flex-wrap gap-3">
        <Button href={workflowPage} variant="secondary">How It Works →</Button>
        <Button href={technologyPage} variant="secondary">Technology →</Button>
        <Button href={researchPage} variant="secondary">Research →</Button>
      </div>
    </div>
  </section>
</MainLayout>
