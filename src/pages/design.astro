---
import MainLayout from "../layouts/MainLayout.astro";
import ModelViewer from "../components/design/ModelViewer.astro";
import SectionHeader from "../components/common/SectionHeader.astro";
import Button from "../components/common/Button.astro";

const base = import.meta.env.BASE_URL;

const heroImage = `${base}/images/product/design-overview.jpg`;
const topImage = `${base}/images/product/design-top.jpg`;
const accessImage = `${base}/images/product/design-access.jpg`;
const explodedImage = `${base}/images/product/design-exploded.jpg`;
const carrierImage = `${base}/images/product/design-carrier.jpg`;
const compartmentImage = `${base}/images/product/design-compartment.jpg`;

const fullModel = `${base}/models/medicine-dispenser.glb`;
const explodedModel = `${base}/models/medicine-dispenser-exploded.glb`;
const carrierModel = `${base}/models/medicine-dispenser-carrier.glb`;
const compartmentModel = `${base}/models/medicine-dispenser-compartment.glb`;

const workflowPage = `${base}/how-it-works/`;
const technologyPage = `${base}/technology/`;

const architecture = [
  {
    number: "01",
    title: "Fixed base",
    description:
      "The fixed base defines twelve slots, A through L. It provides the physical reference, a single camera and lighting setup whose image covers both Slot A and Slot L, and controlled access at Slot L.",
  },
  {
    number: "02",
    title: "Carousel",
    description:
      "The carousel is a rotating component with twelve identical positions, P1 through P12, that can hold pill containers. It rotates in 30-degree steps to align each position with a base slot.",
  },
  {
    number: "03",
    title: "Removable pill containers",
    description:
      "Each pill container is given a unique ID at loading and keeps it while inside the dispenser. It is placed securely in one of the carousel's twelve positions and rotates with the carousel.",
  },
];

const facts = [
  {
    value: "12",
    label: "Carrier positions",
    detail: "P1 through P12",
  },
  {
    value: "11",
    label: "Maximum pill containers",
    detail: "At least one position remains empty",
  },
  {
    value: "30°",
    label: "Rotation per step",
    detail: "One step per CW / CCW command",
  },
  {
    value: "P1 at Slot L",
    label: "Home position",
    detail: "Known physical starting pose",
  },
];

const locations = [
  {
    slot: "A",
    title: "AI verification",
    description:
      "Each pill container is placed at Slot A for AI verification of its contents, both at loading and before making it available for the patient to pick up. The camera always photographs the container at this slot to ensure consistent image quality.",
  },
  {
    slot: "L",
    title: "Loading and pickup",
    description:
      "Slot L is where the caregiver loads filled pill containers and the patient picks up each verified dose. Using images from the same camera, AI confirms pickup from Slot L.",
  },
];
---

<MainLayout
  title="Industrial Design | MediSAFE: Medication Dispenser"
  description="Explore the industrial design, removable pill containers, carousel, fixed base, and interactive 3D models of the medication dispensing prototype."
>
  <section class="overflow-hidden py-14 sm:py-16 lg:py-20">
    <div class="mx-auto grid max-w-[1280px] grid-cols-1 items-center gap-12 px-6 lg:grid-cols-[0.82fr_1.18fr] lg:gap-20 lg:px-10">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-orange)]">
          Industrial Design
        </p>

        <h1 class="mt-5 max-w-[760px] text-3xl font-semibold leading-[1.08] tracking-tight sm:text-4xl lg:text-6xl">
          A desktop dispenser built around a carousel of removable pill containers.
        </h1>

        <p class="mt-5 max-w-[680px] sm:mt-6 text-base leading-7 text-[var(--color-text-secondary)] lg:text-lg lg:leading-8">
          The dispenser combines a fixed base, a twelve-position carousel, removable pill containers, a designated AI verification slot (Slot A), and a designated loading and pickup slot (Slot L) in one desktop prototype.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="#interactive-model">Explore the 3D Model</Button>
          <Button href={workflowPage} variant="secondary">See the Workflow</Button>
        </div>
      </div>

      <div class="overflow-hidden rounded-[2rem] bg-white p-6 lg:p-10">
        <img
          src={heroImage}
          alt="Medication dispenser showing the carousel, removable pill containers, camera structure, and access slot"
          class="mx-auto w-full"
        />
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Mechanical Architecture"
        title="Three major mechanical components defining access, motion, and identity."
        description="The components include the fixed base, the rotating carousel, and the removable pill containers. Together, they let medication be loaded, inspected, stored securely, and dispensed automatically, all while keeping it hygienic. The portable containers also let the patient take a dose along when away from home."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-5 lg:grid-cols-3">
        {
          architecture.map((item) => (
            <article class="rounded-3xl border border-[var(--color-border)] bg-[var(--color-background)] p-7 lg:p-8">
              <p class="text-sm font-semibold text-[var(--color-accent-orange)]">
                {item.number}
              </p>
              <h2 class="mt-5 text-2xl font-semibold">{item.title}</h2>
              <p class="mt-4 leading-7 text-[var(--color-text-secondary)]">
                {item.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Carousel"
        title="Twelve identical positions that can store up to eleven pill containers."
        description="The carousel has twelve equally spaced positions. One position is always kept empty, so no pill container is ever stored at the loading slot (Slot L). Pairing each container's ID with its carousel position ID at loading lets containers be placed in any available position and moved as needed for inspection, storage, and dispensing."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16">
        <div class="overflow-hidden rounded-[2rem] bg-white p-6 lg:p-10">
          <img
            src={carrierImage}
            alt="Carousel with twelve identical positions to store pill containers"
            class="mx-auto w-full"
          />
        </div>

        <div class="grid grid-cols-2 gap-4">
          {
            facts.map((fact) => (
              <article class="rounded-3xl border border-[var(--color-border)] bg-white p-6">
                <p class="text-3xl font-semibold text-[var(--color-accent-orange)] lg:text-4xl">
                  {fact.value}
                </p>
                <h2 class="mt-4 font-semibold">{fact.label}</h2>
                <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">
                  {fact.detail}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-graphite)] py-14 text-white sm:py-16 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Slots of the Fixed Base"
        title="Loading, verification, and pickup are conducted at dedicated slots."
        description="The fixed base remains stationary while the carousel rotates. Every motion aims to align a specific carousel position, and therefore a specific pill container, with the desired slot."
        light
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
        {
          locations.map((location) => (
            <article class="rounded-[2rem] border border-white/15 bg-white/5 p-8 lg:p-10">
              <div class="flex items-start gap-6">
                <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-[var(--color-accent-teal)] text-2xl font-semibold text-[var(--color-graphite)]">
                  {location.slot}
                </div>
                <div>
                  <h2 class="text-2xl font-semibold">{location.title}</h2>
                  <p class="mt-4 leading-7 text-white/65">
                    {location.description}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <p class="mt-8 max-w-[900px] text-sm leading-7 text-white/60">
        The carousel is in its home position when P1 is at Slot L. From this known position, the controller can move the carousel precisely to the slot needed for verification, loading, or pickup.
      </p>
    </div>
  </section>

  <section id="interactive-model" class="scroll-mt-24 py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-[0.62fr_1.38fr] lg:gap-16">
        <div>
          <SectionHeader
            label="Interactive Model"
            title="Explore the assembled prototype from every angle."
            description="Rotate and zoom the model to examine the fixed base, carousel, removable pill containers, enclosure, camera structure, and Slot L access."
          />

          <p class="mt-8 border-t border-[var(--color-border)] pt-6 text-sm leading-7 text-[var(--color-text-secondary)]">
            The interactive model represents the current prototype geometry. Mechanical details may continue to evolve as retention, ejection, sensing, and patient-access mechanisms are tested.
          </p>
        </div>

        <ModelViewer
          modelPath={fullModel}
          posterPath={heroImage}
          title="Complete Dispenser"
          description="Drag to rotate. Scroll or pinch to zoom."
          alt="Interactive 3D model of the complete medication dispenser"
          viewerId="complete-device-model"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Component Models"
        title="Inspect the mechanical system at multiple levels."
        description="Separate models make it easier to understand how the assembly is constructed and how the carousel and removable pill containers relate to the complete dispenser."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <ModelViewer
          modelPath={explodedModel}
          posterPath={explodedImage}
          title="Exploded Assembly"
          description="Explore the major mechanical layers and their relationship."
          alt="Interactive exploded 3D model of the medication dispenser"
          viewerId="exploded-device-model"
          heightClass="device-model-compact"
        />

        <ModelViewer
          modelPath={carrierModel}
          posterPath={carrierImage}
          title="Carousel"
          description="Examine the carousel and how the pill containers can be arranged on it."
          alt="Interactive 3D model of the medication dispenser carousel"
          viewerId="carrier-model"
          heightClass="device-model-compact"
        />

        <ModelViewer
          modelPath={compartmentModel}
          posterPath={compartmentImage}
          title="Removable Pill Container"
          description="Inspect the pill container's shape and the features that hold it in place."
          alt="Interactive 3D model of a removable pill container"
          viewerId="compartment-model"
          heightClass="device-model-compact"
        />

        <article class="overflow-hidden rounded-[2rem] border border-[var(--color-border)] bg-[var(--color-background)]">
          <img
            src={topImage}
            alt="Top view of the medication dispenser and its carousel"
            class="aspect-[4/3] w-full object-cover"
          />
          <div class="p-7">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-orange)]">
              Top View
            </p>
            <h2 class="mt-3 text-2xl font-semibold">Fixed slots around a rotating carousel.</h2>
            <p class="mt-4 leading-7 text-[var(--color-text-secondary)]">
              The top view shows how the round carousel turns within the fixed base, while Slot A and Slot L stay in place.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Removable Pill Container"
        title="Each pill container holds one prepared dose, which may contain multiple medications."
        description="Each pill container is given a unique ID at loading and keeps it while inside the dispenser. Magnets and the carousel walls hold it securely while the carousel moves, while still letting the caregiver load it and the patient pick it up."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div class="overflow-hidden rounded-[2rem] bg-white p-6 lg:p-10">
          <img
            src={compartmentImage}
            alt="Removable pill container showing its enclosure and handle"
            class="mx-auto w-full"
          />
        </div>

        <div class="grid gap-5">
          <article class="rounded-3xl border border-[var(--color-border)] bg-white p-7">
            <h2 class="text-xl font-semibold">Unique ID</h2>
            <p class="mt-3 leading-7 text-[var(--color-text-secondary)]">
              At loading, the container is given its dose's unique ID. That ID is then tied to the carousel position where the container is stored.
            </p>
          </article>

          <article class="rounded-3xl border border-[var(--color-border)] bg-white p-7">
            <h2 class="text-xl font-semibold">Secure during motion</h2>
            <p class="mt-3 leading-7 text-[var(--color-text-secondary)]">
              Magnets and the walls of the carousel keep the container from shifting while the carousel rotates between slots.
            </p>
          </article>

          <article class="rounded-3xl border border-[var(--color-border)] bg-white p-7">
            <h2 class="text-xl font-semibold">Deliberately removable</h2>
            <p class="mt-3 leading-7 text-[var(--color-text-secondary)]">
              The container can be loaded, picked up, refilled, and loaded again. Each time it's loaded, its ID is tied to its new dose.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Design Views"
        title="Current prototype geometry from assembly to access details."
      />

      <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3">
        <figure class="overflow-hidden rounded-[2rem] bg-[var(--color-background)] p-5">
          <img
            src={accessImage}
            alt="Side view of the medication dispenser showing the loading and pickup slot (Slot L)"
            class="w-full rounded-[1.5rem]"
          />
          <figcaption class="px-2 pb-2 pt-5 text-sm leading-6 text-[var(--color-text-secondary)]">
            Access-side view showing how the carousel lines up with Slot L, where pill containers are loaded and picked up.
          </figcaption>
        </figure>

        <figure class="overflow-hidden rounded-[2rem] bg-[var(--color-background)] p-5">
          <img
            src={explodedImage}
            alt="Exploded view of the medication dispenser's mechanical assembly"
            class="w-full rounded-[1.5rem]"
          />
          <figcaption class="px-2 pb-2 pt-5 text-sm leading-6 text-[var(--color-text-secondary)]">
            Exploded assembly illustrating the major mechanical components and the camera holding structure.
          </figcaption>
        </figure>

        <figure class="overflow-hidden rounded-[2rem] bg-[var(--color-background)] p-5">
          <img
            src={topImage}
            alt="Top view of the medication dispenser carousel"
            class="w-full rounded-[1.5rem]"
          />
          <figcaption class="px-2 pb-2 pt-5 text-sm leading-6 text-[var(--color-text-secondary)]">
            Top view of the twelve-position carousel within the fixed base.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="rounded-[2rem] border border-[var(--color-border)] bg-white p-8 lg:flex lg:items-end lg:justify-between lg:gap-12 lg:p-12">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-orange)]">
            Next
          </p>
          <h2 class="mt-4 max-w-[760px] text-2xl font-semibold leading-tight sm:text-3xl lg:text-4xl">
            See how the mechanical system connects to software and control.
          </h2>
          <p class="mt-5 max-w-[760px] text-lg leading-8 text-[var(--color-text-secondary)]">
            Continue to Technology for the application architecture, embedded controller, data storage, and system interfaces behind the dispenser.
          </p>
        </div>

        <div class="mt-8 shrink-0 lg:mt-0">
          <Button href={technologyPage}>Technology →</Button>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
