---
import MainLayout from "../layouts/MainLayout.astro";
import SectionHeader from "../components/common/SectionHeader.astro";
import Button from "../components/common/Button.astro";
import StatusBadge from "../components/research/StatusBadge.astro";
import DevelopmentTimeline from "../components/research/DevelopmentTimeline.astro";

const base = import.meta.env.BASE_URL;
const visionPage = `${base}/vision/`;

const researchAreas = [
  {
    title: "Mechanical Design",
    description:
      "Retention force, carrier geometry, compartment alignment, manual removal, and indexed movement.",
  },
  {
    title: "Computer Vision",
    description:
      "Medication verification, image repeatability, detection confidence, and compartment presence classification.",
  },
  {
    title: "Motion Control",
    description:
      "Homing, positioning repeatability, motor profiles, backlash, and safe movement.",
  },
  {
    title: "Safety & Interlocks",
    description:
      "Partial-removal detection, hand-off safety, fault states, and recovery behavior.",
  },
  {
    title: "Software Architecture",
    description:
      "Workflow orchestration, persistence, state management, simulation, and hardware integration.",
  },
  {
    title: "Human Interaction",
    description:
      "Loading, compartment return, refill, patient pickup, caregiver resolution, and alert workflows.",
  },
];

const openQuestions = [
  "Magnet type and retention force",
  "Compartment identity sensing",
  "Hand-off presence sensing",
  "Partial-removal interlock mechanism",
  "Camera field of view",
  "Carrier bearing and drive geometry",
  "Return and reinstall workflow",
];

const validation = [
  {
    area: "Magnetic retention",
    method: "Repeated loaded rotation testing",
    evidence:
      "No unintended displacement or ejection of installed compartments.",
  },
  {
    area: "Manual removal",
    method: "Human-factor bench testing",
    evidence:
      "Presented compartment can be removed without tools or disturbing adjacent compartments.",
  },
  {
    area: "Indexing",
    method: "Repeated homing and positioning",
    evidence:
      "Every compartment repeatedly reaches inspection and hand-off alignment.",
  },
  {
    area: "Inspection framing",
    method: "Image repeatability testing",
    evidence:
      "Each compartment is consistently framed for medication analysis.",
  },
  {
    area: "Pickup detection",
    method: "Presence / absence testing",
    evidence:
      "System reliably distinguishes installed versus removed compartments.",
  },
  {
    area: "Partial-removal safety",
    method: "Fault-injection testing",
    evidence:
      "Motion is rejected when the hand-off condition is unsafe.",
  },
  {
    area: "Power-loss recovery",
    method: "Power interruption testing",
    evidence:
      "System re-homes and reconciles compartment state before automatic operation resumes.",
  },
  {
    area: "End-to-end workflow",
    method: "Integrated scenario testing",
    evidence:
      "Due → inspect → verify → hand-off → pickup verification → software update completes deterministically.",
  },
];
---

<MainLayout
  title="Research & Development | MediSAFE: Medication Dispenser"
  description="Follow the current evidence, open engineering decisions, planned validation work, and development progression of the medicine dispensing prototype."
>
  <!-- Hero -->
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="flex flex-wrap items-center gap-3">
        <p
          class="
            text-sm
            font-semibold
            uppercase
            tracking-[0.18em]
            text-[var(--color-accent-orange)]
          "
        >
          Research & Development
        </p>

        <StatusBadge status="INTERIM RESULT" />
      </div>

      <h1
        class="
          mt-5
          max-w-[980px]
          text-3xl
          font-semibold
          leading-[1.08]
          tracking-tight
          sm:text-4xl
          lg:text-6xl
        "
      >
        A prototype shaped by evidence, open questions, and planned validation.
      </h1>

      <p
        class="
          mt-7
          max-w-[820px]
          text-base
          leading-7
          text-[var(--color-text-secondary)]
          lg:text-lg
          lg:leading-8
        "
      >
        The project remains an integrated engineering prototype.
        Current artifacts document product definition, industrial design,
        system architecture, and interim computer-vision behavior. Several
        mechanical, sensing, motion-control, safety, and human-factor
        questions remain intentionally unresolved until test evidence is available.
      </p>
    </div>
  </section>

  <!-- Status guide -->
  <section class="bg-white py-12 lg:py-16">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div
        class="
          grid
          grid-cols-1
          gap-5
          lg:grid-cols-[0.8fr_1.2fr]
          lg:items-start
          lg:gap-16
        "
      >
        <div>
          <p
            class="
              text-sm
              font-semibold
              uppercase
              tracking-[0.18em]
              text-[var(--color-accent-orange)]
            "
          >
            Evidence Language
          </p>

          <h2 class="mt-4 text-2xl font-semibold lg:text-3xl">
            Status labels distinguish evidence from intent.
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <StatusBadge status="INTERIM RESULT" />
            <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">
              Development evidence exists, but formal validation is incomplete.
            </p>
          </div>

          <div>
            <StatusBadge status="OPEN DECISION" />
            <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">
              An engineering choice remains unresolved pending evidence.
            </p>
          </div>

          <div>
            <StatusBadge status="PLANNED VALIDATION" />
            <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">
              A validation method is defined, but the result is not yet available.
            </p>
          </div>

          <div>
            <StatusBadge status="VALIDATED RESULT" />
            <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">
              Reserved for conclusions supported by defined evidence and acceptance criteria.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Current evidence -->
  <section class="py-16 lg:py-28">
    <div
      class="
        mx-auto
        grid
        max-w-[1280px]
        grid-cols-1
        gap-10
        px-6
        lg:grid-cols-[0.8fr_1.2fr]
        lg:items-start
        lg:gap-20
        lg:px-10
      "
    >
      <SectionHeader
        label="Current Evidence"
        title="The computer-vision work is the first documented implementation evidence."
        description="Four current inspection images demonstrate object annotation, pill-type labeling, and model-output confidence under single-object and increasingly complex mixed-object scenes."
      />

      <article
        class="
          rounded-[2rem]
          border
          border-[var(--color-border)]
          bg-white
          p-7
          lg:p-9
        "
      >
        <StatusBadge status="INTERIM RESULT" />

        <h2 class="mt-5 text-2xl font-semibold">
          Visual Inspection Interim Results
        </h2>

        <p
          class="
            mt-4
            leading-7
            text-[var(--color-text-secondary)]
          "
        >
          Current annotated images show PILL_A, PILL_B, mixed pill
          types, and a crowded multi-object scene. The displayed
          confidence values are model outputs and are not presented
          as a measured system accuracy rate.
        </p>

        <div class="mt-7">
          <Button href={visionPage} variant="secondary">
            View Vision Evidence →
          </Button>
        </div>
      </article>
    </div>
  </section>

  <!-- Research areas -->
  <section class="bg-white py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Research Areas"
        title="Six disciplines converge in the current prototype."
      />

      <div
        class="
          mt-12
          grid
          grid-cols-1
          gap-5
          lg:grid-cols-3
        "
      >
        {
          researchAreas.map((area, index) => (
            <article
              class="
                rounded-3xl
                border
                border-[var(--color-border)]
                bg-[var(--color-background)]
                p-7
              "
            >
              <p
                class="
                  text-sm
                  font-semibold
                  text-[var(--color-accent-orange)]
                "
              >
                {String(index + 1).padStart(2, "0")}
              </p>

              <h2 class="mt-5 text-xl font-semibold">
                {area.title}
              </h2>

              <p
                class="
                  mt-4
                  leading-7
                  text-[var(--color-text-secondary)]
                "
              >
                {area.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Open engineering decisions -->
  <section class="py-16 lg:py-28">
    <div
      class="
        mx-auto
        grid
        max-w-[1280px]
        grid-cols-1
        gap-12
        px-6
        lg:grid-cols-[0.75fr_1.25fr]
        lg:gap-20
        lg:px-10
      "
    >
      <div>
        <SectionHeader
          label="Open Engineering Decisions"
          title="Several design choices remain intentionally unresolved."
          description="These questions require mechanical testing, sensing experiments, image evaluation, or human-factor validation before the product architecture is finalized."
        />

        <div class="mt-6">
          <StatusBadge status="OPEN DECISION" />
        </div>
      </div>

      <div
        class="
          overflow-hidden
          rounded-3xl
          border
          border-[var(--color-border)]
          bg-white
        "
      >
        {
          openQuestions.map((question, index) => (
            <div
              class="
                flex
                gap-5
                border-b
                border-[var(--color-border)]
                px-6
                py-5
                last:border-b-0
              "
            >
              <span
                class="
                  text-sm
                  font-semibold
                  text-[var(--color-accent-orange)]
                "
              >
                {String(index + 1).padStart(2, "0")}
              </span>

              <span>
                {question}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Planned validation -->
  <section class="bg-white py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div
        class="
          flex
          flex-col
          gap-5
          lg:flex-row
          lg:items-end
          lg:justify-between
        "
      >
        <SectionHeader
          label="Planned Validation"
          title="Prototype requirements are paired with observable test evidence."
          description="These methods define how future integrated testing can establish whether the prototype meets its intended mechanical, sensing, safety, and workflow behavior."
        />

        <div class="shrink-0">
          <StatusBadge status="PLANNED VALIDATION" />
        </div>
      </div>

      <div class="mt-12 space-y-4">
        {
          validation.map((item) => (
            <article
              class="
                grid
                grid-cols-1
                gap-5
                rounded-3xl
                border
                border-[var(--color-border)]
                bg-[var(--color-background)]
                p-6
                lg:grid-cols-[0.6fr_0.8fr_1.6fr]
                lg:items-start
              "
            >
              <div>
                <p
                  class="
                    text-xs
                    font-semibold
                    uppercase
                    tracking-[0.12em]
                    text-[var(--color-accent-orange)]
                  "
                >
                  Area
                </p>

                <p class="mt-2 font-semibold">
                  {item.area}
                </p>
              </div>

              <div>
                <p
                  class="
                    text-xs
                    font-semibold
                    uppercase
                    tracking-[0.12em]
                    text-[var(--color-accent-orange)]
                  "
                >
                  Method
                </p>

                <p
                  class="
                    mt-2
                    text-[var(--color-text-secondary)]
                  "
                >
                  {item.method}
                </p>
              </div>

              <div>
                <p
                  class="
                    text-xs
                    font-semibold
                    uppercase
                    tracking-[0.12em]
                    text-[var(--color-accent-orange)]
                  "
                >
                  Intended Evidence
                </p>

                <p
                  class="
                    mt-2
                    leading-7
                    text-[var(--color-text-secondary)]
                  "
                >
                  {item.evidence}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Development timeline -->
  <section class="py-16 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Development Timeline"
        title="The prototype has progressed from requirements to implementation evidence."
        description="The timeline summarizes the current engineering progression without implying that planned integrated validation has already been completed."
      />

      <DevelopmentTimeline />
    </div>
  </section>

  <!-- Prototype status -->
  <section
    class="
      bg-[var(--color-graphite)]
      py-16
      text-white
      lg:py-28
    "
  >
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Prototype Status"
        title="The current design remains intentionally iterative."
        description="Mechanical architecture, sensing choices, vision performance, motion repeatability, safety behavior, and caregiver ergonomics will continue to evolve as integrated prototype testing produces evidence."
        light={true}
      />
    </div>
  </section>
</MainLayout>
