---
import MainLayout from "../layouts/MainLayout.astro";
import SectionHeader from "../components/common/SectionHeader.astro";
import Button from "../components/common/Button.astro";
import StatusBadge from "../components/research/StatusBadge.astro";
import DevelopmentTimeline from "../components/research/DevelopmentTimeline.astro";

const base = import.meta.env.BASE_URL;
const visionPage = `${base}/vision/`;
const technologyPage = `${base}/technology/`;

const evidenceAreas = [
  {
    title: "Product Definition",
    status: "DOCUMENTED BASELINE" as const,
    description:
      "Current product and system requirements define actors, schedule generation, compartment preparation, grouped dispense events, pickup outcomes, recovery behavior, and first integrated acceptance objectives.",
  },
  {
    title: "Industrial Design",
    status: "INTERIM RESULT" as const,
    description:
      "The current design establishes a 12-position indexed carrier, fixed Base Slots A-L, removable compartments, Slot A inspection, and Slot L loading, dispensing, and external access behavior.",
  },
  {
    title: "Software Architecture",
    status: "INTERIM RESULT" as const,
    description:
      "The prototype separates application workflows from device, camera, vision, persistence, notification, and embedded-control boundaries to support simulation and incremental hardware integration.",
  },
  {
    title: "Computer Vision",
    status: "INTERIM RESULT" as const,
    description:
      "Annotated development examples demonstrate pill localization, classification, counting, and structured inspection outcomes, while formal performance validation remains open.",
  },
];

const researchAreas = [
  {
    number: "01",
    title: "Mechanical Design",
    description:
      "Carrier geometry, retention, compartment insertion and removal, indexed alignment, ejection behavior, and post-dispense access.",
  },
  {
    number: "02",
    title: "Computer Vision",
    description:
      "Medication verification, image repeatability, pill classification, confidence behavior, failure outcomes, and camera geometry.",
  },
  {
    number: "03",
    title: "Motion & Embedded Control",
    description:
      "Homing, one-index motion, positioning repeatability, interlocks, actuator behavior, fault handling, and controller state transitions.",
  },
  {
    number: "04",
    title: "Safety & Recovery",
    description:
      "Unsafe-state inhibition, inspection failure handling, startup reconciliation, power-loss recovery, and exception resolution before automatic operation resumes.",
  },
  {
    number: "05",
    title: "Software & Data",
    description:
      "Prescription-driven scheduling, same-time event grouping, compartment identity and placement, transactional persistence, simulation, audit history, and workflow orchestration.",
  },
  {
    number: "06",
    title: "Human Interaction",
    description:
      "Caregiver loading and refill, direct controls, patient pickup, timeout and ambiguity resolution, understandable state presentation, and accessible daily-use workflows.",
  },
];

const acceptancePlan = [
  {
    area: "HOME reference",
    method: "Repeated HOME and index test",
    evidence: "P1 repeatedly aligns with Base Slot L.",
  },
  {
    area: "Indexed motion",
    method: "CW / CCW command and reversal test",
    evidence: "Each command changes pose by one 30-degree index and reversing returns the prior pose.",
  },
  {
    area: "Dynamic placement",
    method: "Load, refill, and reinsertion scenarios",
    evidence: "Compartment C-ID remains associated with its actual current carrier P-position.",
  },
  {
    area: "Schedule grouping",
    method: "Scheduling integration test",
    evidence: "Medication occurrences due at the exact same time become one physical dispense event with combined expected contents.",
  },
  {
    area: "Slot A inspection",
    method: "Positioning and inspection workflow test",
    evidence: "Every eligible prepared compartment can be positioned at Slot A and evaluated against its expected contents.",
  },
  {
    area: "Failed inspection",
    method: "Workflow and fault test",
    evidence: "The affected event is blocked, the compartment remains installed in an error state, and unrelated safe events can remain serviceable.",
  },
  {
    area: "Successful dispense",
    method: "Integrated dispense test",
    evidence: "The verified compartment reaches Slot L, leaves the carrier, its P-position becomes empty, and DISPENSED is recorded.",
  },
  {
    area: "Schedule preparation",
    method: "API / UI integration test",
    evidence: "Future device events accurately distinguish already-loaded from not-yet-loaded preparation state.",
  },
  {
    area: "Recovery",
    method: "Restart and contradiction scenarios",
    evidence: "Motion remains inhibited until HOME, pose, compartment placement, and external access state are reconciled.",
  },
];

const openQuestions = [
  {
    title: "Post-dispense access",
    description:
      "Define the final tray, hatch, receptacle, or other controlled access geometry and how collected, timed-out, or ambiguous outcomes are sensed.",
  },
  {
    title: "Ejection behavior",
    description:
      "Determine whether EJECT is fully motorized, mechanically assisted, or application-guided, including the associated safety behavior.",
  },
  {
    title: "Twelfth compartment role",
    description:
      "Confirm whether the twelfth registered compartment is spare, staging, or normal inventory while maximum installed capacity remains eleven.",
  },
  {
    title: "Compartment identification",
    description:
      "Select the machine-readable technology used to establish persistent C-ID independently from carrier position.",
  },
  {
    title: "Slot L safety sensing",
    description:
      "Define the interlock and ejection-path sensing architecture required to prevent unsafe motion or dispense behavior.",
  },
  {
    title: "Camera and sensor geometry",
    description:
      "Resolve one-camera versus multi-camera or mixed-sensor coverage for loading, inspection, identity, and access workflows.",
  },
  {
    title: "Vision-unavailable policy",
    description:
      "Define safe behavior, recovery, and any allowed override when the vision service is unavailable or returns an unresolved result.",
  },
  {
    title: "Clinical guardrails",
    description:
      "Define how prescription and maximum-consumption rules are validated without overstating the prototype as a clinical decision system.",
  },
  {
    title: "Concurrent due events",
    description:
      "Define prioritization when multiple due device events compete for a hardware or patient-access resource.",
  },
  {
    title: "Security and regulatory posture",
    description:
      "Define remote connectivity, data retention, security controls, privacy expectations, and the regulatory path for any future productization.",
  },
];
---

<MainLayout
  title="Research & Development | MediSAFE: Medication Dispenser"
  description="Explore the documented baseline, current engineering evidence, open decisions, and planned verification work behind the MediSAFE medication dispensing prototype."
>
  <!-- Hero -->
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="flex flex-wrap items-center gap-3">
        <p
          class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-orange)]"
        >
          Research & Development
        </p>
        <StatusBadge status="INTERIM RESULT" />
      </div>

      <h1
        class="mt-5 max-w-[960px] text-3xl font-semibold leading-[1.08] tracking-tight sm:text-4xl lg:text-6xl"
      >
        Turning a dispensing concept into testable engineering evidence.
      </h1>

      <p
        class="mt-7 max-w-[830px] text-base leading-7 text-[var(--color-text-secondary)] lg:text-lg lg:leading-8"
      >
        MediSAFE remains an engineering prototype. The current requirements,
        industrial design, architecture, and computer-vision work establish a
        documented direction; integrated mechanical, sensing, safety, and
        end-to-end validation is still planned rather than assumed.
      </p>
    </div>
  </section>

  <!-- Evidence language -->
  <section class="bg-white py-12 lg:py-16">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-orange)]">
            Evidence Language
          </p>
          <h2 class="mt-4 max-w-[520px] text-2xl font-semibold sm:text-3xl lg:text-4xl">
            The site separates what is defined, observed, undecided, and still to be tested.
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <StatusBadge status="DOCUMENTED BASELINE" />
            <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">
              A current requirement, architecture, or design baseline exists and is used to guide implementation.
            </p>
          </div>
          <div>
            <StatusBadge status="INTERIM RESULT" />
            <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">
              Implementation or development evidence exists, but formal acceptance testing is incomplete.
            </p>
          </div>
          <div>
            <StatusBadge status="OPEN DECISION" />
            <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">
              An engineering or product decision remains unresolved pending evidence or design work.
            </p>
          </div>
          <div>
            <StatusBadge status="PLANNED VALIDATION" />
            <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">
              A verification objective is defined, but passing evidence has not yet been established.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Current engineering baseline -->
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Current Engineering Baseline"
        title="Four bodies of work currently anchor the prototype."
        description="Together they define what the product is intended to do, how the physical system is organized, how software responsibilities are separated, and what implementation evidence currently exists."
      />

      <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2">
        {
          evidenceAreas.map((area) => (
            <article class="rounded-3xl border border-[var(--color-border)] bg-white p-7 lg:p-8">
              <StatusBadge status={area.status} />
              <h2 class="mt-5 text-xl font-semibold lg:text-2xl">{area.title}</h2>
              <p class="mt-4 text-sm leading-6 text-[var(--color-text-secondary)] sm:text-base sm:leading-7">
                {area.description}
              </p>
            </article>
          ))
        }
      </div>

      <div class="mt-7 flex flex-wrap gap-3">
        <Button href={technologyPage} variant="secondary">Explore Architecture →</Button>
        <Button href={visionPage} variant="secondary">View Vision Evidence →</Button>
      </div>
    </div>
  </section>

  <!-- Research workstreams -->
  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Engineering Workstreams"
        title="Six disciplines converge in the integrated prototype."
        description="Progress in one area changes constraints in the others, so the research program is intentionally system-oriented rather than a collection of isolated experiments."
      />

      <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          researchAreas.map((area) => (
            <article class="rounded-3xl border border-[var(--color-border)] bg-[var(--color-background)] p-7">
              <p class="text-sm font-semibold text-[var(--color-accent-orange)]">{area.number}</p>
              <h2 class="mt-4 text-xl font-semibold">{area.title}</h2>
              <p class="mt-3 text-sm leading-6 text-[var(--color-text-secondary)] sm:text-base sm:leading-7">
                {area.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Planned verification -->
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeader
          label="Verification & Acceptance"
          title="Requirements are being translated into observable pass evidence."
          description="The current PRD and SRD define first integrated prototype objectives that can be exercised through repeatable motion, workflow, integration, browser, and recovery tests."
        />
        <div class="shrink-0">
          <StatusBadge status="PLANNED VALIDATION" />
        </div>
      </div>

      <div class="mt-10 overflow-hidden rounded-3xl border border-[var(--color-border)] bg-white">
        {
          acceptancePlan.map((item, index) => (
            <article class="grid grid-cols-1 gap-4 border-b border-[var(--color-border)] px-6 py-6 last:border-b-0 lg:grid-cols-[0.65fr_0.95fr_1.4fr] lg:gap-8 lg:px-8">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-accent-orange)]">{String(index + 1).padStart(2, "0")}</p>
                <p class="mt-2 font-semibold">{item.area}</p>
              </div>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-text-secondary)]">Method</p>
                <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)] sm:text-base">{item.method}</p>
              </div>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-text-secondary)]">Pass evidence</p>
                <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)] sm:text-base">{item.evidence}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Open decisions -->
  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
        <div>
          <SectionHeader
            label="Open Engineering Decisions"
            title="The unresolved questions are explicit rather than hidden."
            description="These items remain open because they affect safety, sensing, mechanical behavior, clinical guardrails, or future productization and require evidence before the architecture is finalized."
          />
          <div class="mt-6"><StatusBadge status="OPEN DECISION" /></div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {
            openQuestions.map((question, index) => (
              <article class="rounded-3xl border border-[var(--color-border)] bg-[var(--color-background)] p-6">
                <div class="flex items-start gap-4">
                  <span class="shrink-0 text-sm font-semibold text-[var(--color-accent-orange)]">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <h3 class="font-semibold">{question.title}</h3>
                    <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">
                      {question.description}
                    </p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Development timeline -->
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <SectionHeader
        label="Development Progression"
        title="The project is moving from definition toward integrated verification."
        description="The sequence below summarizes the current engineering progression without presenting planned validation as completed evidence."
      />
      <DevelopmentTimeline />
    </div>
  </section>

  <!-- Current status -->
  <section class="bg-[var(--color-graphite)] py-16 text-white lg:py-24">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_0.8fr] lg:items-end lg:gap-16">
        <SectionHeader
          label="Prototype Status"
          title="The next milestone is evidence from the integrated system."
          description="Mechanical retention and ejection, sensing, indexed motion, vision behavior, workflow recovery, schedule-driven preparation, and end-to-end dispense scenarios still require systematic integrated testing before stronger product claims are appropriate."
          light={true}
        />

        <div class="rounded-3xl border border-white/15 bg-white/5 p-7">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-white/65">Research principle</p>
          <p class="mt-4 text-lg font-medium leading-8">
            Treat requirements as hypotheses to verify, implementation artifacts as interim evidence, and safety-critical uncertainty as an explicit engineering decision.
          </p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
