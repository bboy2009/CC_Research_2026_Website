---
import SectionHeader from "../common/SectionHeader.astro";

const capabilities = [
  {
    number: "01",
    title: "Prescription-Driven Scheduling",
    description: "Every prescription is automatically translated into one combined, editable schedule, so no dose needs to be entered individually.",
  },
  {
    number: "02",
    title: "Schedule-Driven Preparation",
    description: "The caregiver can check the app to see which pills belong to the same dose and go into the same container.",
  },
  {
    number: "03",
    title: "AI Verification",
    description: "Before the container is released for pickup by the patient, a camera photographs it. An AI model then confirms that its contents match the scheduled dose.",
  },
  {
    number: "04",
    title: "Controlled Release & Pickup",
    description: "Once the check passes, the carousel rotates the container to Slot L. At the next scheduled dose, AI confirms pickup by checking that it is now empty.",
  },
];
---

<section class="py-14 sm:py-14 sm:py-16 lg:py-20">
  <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
    <SectionHeader
      label="Core Capabilities"
      title="A connected workflow from prescription to pickup."
    />

    <div class="mt-9 sm:mt-10 lg:mt-12 grid grid-cols-1 gap-5 lg:grid-cols-4">
      {capabilities.map((item) => (
        <article class="rounded-3xl border border-[var(--color-border)] bg-white p-7 transition lg:hover:-translate-y-1 lg:hover:shadow-lg">
          <p class="text-sm font-semibold text-[var(--color-accent-orange)]">{item.number}</p>
          <h3 class="mt-6 text-2xl font-semibold">{item.title}</h3>
          <p class="mt-4 leading-7 text-[var(--color-text-secondary)]">{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
