---
import SectionHeader from "../common/SectionHeader.astro";
---

<section id="product" class="scroll-mt-20 bg-white py-14 sm:py-14 sm:py-16 lg:py-20">
  <div class="mx-auto grid max-w-[1280px] grid-cols-1 gap-10 px-6 lg:grid-cols-[0.55fr_1.45fr] lg:gap-20 lg:px-10">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-orange)]">
         
      </p>
    </div>

    <div>
      <SectionHeader
        label="The Concept"
        title="One removable container for each combined dose."
        description="All medications due at the same time are grouped into one dose. The caregiver then fills one removable container with exactly those pills."
      />

      <p class="mt-5 max-w-[800px] sm:mt-6 text-lg leading-8 text-[var(--color-text-secondary)]">
        The carousel holds up to eleven containers in twelve positions. Slot L is used only for loading and pickup. When a dose is due, its container moves to Slot A for AI verification. Only after the pills pass inspection does it move to Slot L for pickup by the patient. At the next scheduled dose, AI confirms pickup if there is no container at Slot L or the container is empty.
      </p>
    </div>
  </div>
</section>
