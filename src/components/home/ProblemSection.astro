---
import SectionHeader from "../common/SectionHeader.astro";
---

<section
  id="product"
  class="scroll-mt-20 bg-white py-16 lg:py-28"
>
  <div
    class="
      mx-auto
      grid
      max-w-[1280px]
      grid-cols-1
      gap-10
      px-6
      lg:grid-cols-[0.7fr_1.3fr]
      lg:gap-20
      lg:px-10
    "
  >
    <div>
      <p
        class="
          text-sm
          font-semibold
          uppercase
          tracking-[0.18em]
          text-[var(--color-accent-orange)]
        "
      >
        The Concept
      </p>
    </div>

    <SectionHeader
      label="Product Direction"
      title="Designed around controlled, verified medication hand-off."
      description="The prototype organizes medication into individual removable dose compartments. When a dose becomes due, the system positions the correct compartment for inspection, verifies its contents, and only then presents the complete compartment for pickup."
    />
  </div>
</section>