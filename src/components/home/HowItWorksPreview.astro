---
import SectionHeader from "../common/SectionHeader.astro";

const steps = [
  { number: "01", title: "Prescription", description: "All prescriptions are converted into a combined dispensing schedule." },
  { number: "02", title: "Prepare", description: "The app shows the caregiver which pills belong to the same dose." },
  { number: "03", title: "Load", description: "The caregiver fills the container and loads it at Slot L." },
  { number: "04", title: "Inspect", description: "At dose time, the carousel rotates the container to Slot A, and AI verifies its contents against the scheduled dose." },
  { number: "05", title: "Dispense", description: "If the contents are verified, the carousel rotates the container to Slot L for pickup by the patient." },
  { number: "06", title: "Track Pickup", description: "At the next scheduled dose, AI checks that the container is empty and alerts the caregiver if it is not." },
];
---

<section id="how-it-works" class="scroll-mt-20 bg-white py-14 sm:py-14 sm:py-16 lg:py-20">
  <div class="mx-auto max-w-[1280px] px-6 lg:px-10">
    <SectionHeader
      label="How It Works"
      title="From multiple prescriptions to one verified dose."
      description="Six steps to turn doctors' instructions into verified doses for the patient."
    />

    <div class="mt-10 sm:mt-9 sm:mt-10 lg:mt-12 lg:mt-14 hidden grid-cols-6 gap-3 lg:grid">
      {steps.map((step, index) => (
        <div class="relative">
          <article class="relative z-10 min-h-[270px] rounded-3xl border border-[var(--color-border)] bg-[var(--color-background)] p-6">
            <p class="text-sm font-semibold text-[var(--color-accent-orange)]">{step.number}</p>
            <h3 class="mt-5 text-xl font-semibold">{step.title}</h3>
            <p class="mt-4 text-sm leading-6 text-[var(--color-text-secondary)]">{step.description}</p>
          </article>
          {index < steps.length - 1 && (
            <span class="absolute -right-3 top-1/2 z-20 -translate-y-1/2 text-xl text-[var(--color-accent-orange)]" aria-hidden="true">→</span>
          )}
        </div>
      ))}
    </div>

    <div class="mt-9 sm:mt-10 lg:mt-12 space-y-3 lg:hidden">
      {steps.map((step, index) => (
        <div>
          <article class="rounded-3xl border border-[var(--color-border)] bg-[var(--color-background)] p-6">
            <div class="flex gap-5">
              <span class="text-sm font-semibold text-[var(--color-accent-orange)]">{step.number}</span>
              <div>
                <h3 class="text-xl font-semibold">{step.title}</h3>
                <p class="mt-2 leading-7 text-[var(--color-text-secondary)]">{step.description}</p>
              </div>
            </div>
          </article>
          {index < steps.length - 1 && <div class="flex h-8 items-center justify-center text-[var(--color-accent-orange)]" aria-hidden="true">↓</div>}
        </div>
      ))}
    </div>
  </div>
</section>
