---
import SectionHeader from "../common/SectionHeader.astro";
import Button from "../common/Button.astro";

const base = import.meta.env.BASE_URL;

const researchPage =
  `${base}/research/`;

const researchAreas = [
  {
    number: "01",
    title: "Mechanical Design",
    description:
      "Carousel geometry, removable containers, magnetic retention, gear train, and stepper motor.",
  },
  {
    number: "02",
    title: "Computer Vision",
    description:
      "Image optimization, pill identification, counting, and container presence verification.",
  },
  {
    number: "03",
    title: "Motion Control",
    description:
      "Homing, indexed positioning, repeatability, motor control, and safe movement.",
  },
  {
    number: "04",
    title: "Software Architecture",
    description:
      "Scheduling, workflow orchestration, persistence, vision, and device integration.",
  },
  {
    number: "05",
    title: "Safety & Interlocks",
    description:
      "Safe hand-off state, partial-removal detection, fault handling, and recovery.",
  },
  {
    number: "06",
    title: "Human Interaction",
    description:
      "Container loading, removal, return, refill, notifications, and prescription data entry.",
  },
];
---

<section
  id="research"
  class="scroll-mt-20 bg-white py-14 sm:py-14 sm:py-16 lg:py-20"
>
  <div class="mx-auto max-w-[1280px] px-6 lg:px-10">

    <div
      class="
        grid
        grid-cols-1
        gap-12
        lg:grid-cols-[0.8fr_1.2fr]
        lg:gap-20
      "
    >
      <div>
        <SectionHeader
          label="Research Design & Prototype"
          title="Engineering questions drive each iteration."
          description="Each version of the design and prototype tackles open questions in six areas."
        />

        <div class="mt-8">
          <Button
            href={researchPage}
            variant="secondary"
          >
            Explore the Research →
          </Button>
        </div>
      </div>

      <div
        class="
          grid
          grid-cols-1
          gap-px
          overflow-hidden
          rounded-3xl
          border
          border-[var(--color-border)]
          bg-[var(--color-border)]
          lg:grid-cols-2
        "
      >
        {
          researchAreas.map((area) => (
            <article class="bg-white p-7">
              <p
                class="
                  text-sm
                  font-semibold
                  text-[var(--color-accent-orange)]
                "
              >
                {area.number}
              </p>

              <h3 class="mt-5 text-xl font-semibold">
                {area.title}
              </h3>

              <p
                class="
                  mt-3
                  leading-7
                  text-[var(--color-text-secondary)]
                "
              >
                {area.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>