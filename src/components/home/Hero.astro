---
import Button from "../common/Button.astro";

const base = import.meta.env.BASE_URL;
const imagePath = `${base}/images/product/design-v4b-hero.jpg`;
const workflowPage = `${base}/how-it-works/`;
---

<section class="overflow-hidden py-14 sm:py-16 lg:py-20">
  <div class="mx-auto grid max-w-[1280px] grid-cols-1 items-center gap-12 px-6 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16 lg:px-10">
    <div>
      <p class="mb-5 text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent-orange)]">
        Student Research Project · Smart Medication Dispensing System
      </p>

      <h1 class="max-w-[700px] text-3xl font-semibold leading-[1.08] tracking-tight sm:text-4xl lg:text-6xl">
        Dispensed as doctors prescribed. Verified by AI before release.
      </h1>

      <p class="mt-5 max-w-[620px] sm:mt-6 text-base leading-7 text-[var(--color-text-secondary)] lg:text-lg lg:leading-8">
        A desktop dispenser for patients with complex medication regimens, and a companion app for their caregivers. It combines every prescription into one dose schedule. For patient safety, AI verifies each dose before release and tracks its pickup.
      </p>

      <div class="mt-8">
        <Button href={workflowPage}>Explore the Prototype</Button>
      </div>
    </div>

    <div class="flex items-center justify-center">
      <img
        src={imagePath}
        alt="Medicine dispensing device prototype with removable dose compartment"
        class="block h-auto w-full max-w-[720px] object-contain"
      />
    </div>
  </div>
</section>
