---
import Button from "../common/Button.astro";

const imagePath =
  `${import.meta.env.BASE_URL}/images/product/design-01.jpg`;
---

<section class="overflow-hidden py-16 lg:py-24">
  <div
    class="
      mx-auto
      grid
      max-w-[1280px]
      grid-cols-1
      items-center
      gap-12
      px-6
      lg:grid-cols-[0.85fr_1.15fr]
      lg:gap-16
      lg:px-10
    "
  >
    <div>
      <p
        class="
          mb-5
          text-sm
          font-semibold
          uppercase
          tracking-[0.18em]
          text-[var(--color-accent-orange)]
        "
      >
        Engineering Prototype
      </p>

      <h1
        class="
          max-w-[700px]
          text-4xl
          font-semibold
          leading-[1.05]
          tracking-tight
          lg:text-7xl
        "
      >
        Personal medication management,
        verified before hand-off.
      </h1>

      <p
        class="
          mt-7
          max-w-[600px]
          text-lg
          leading-8
          text-[var(--color-text-secondary)]
          lg:text-xl
        "
      >
        A desktop medication dispensing prototype combining
        automated scheduling, removable dose compartments,
        computer vision verification, and pickup tracking.
      </p>

      <div class="mt-8">
        <Button href="#how-it-works">
          Explore the Prototype
        </Button>
      </div>
    </div>

    <div class="flex items-center justify-center">
      <img
        src={imagePath}
        alt="Medicine dispensing device prototype"
        class="
          block
          h-auto
          w-full
          max-w-[720px]
          object-contain
        "
      />
    </div>
  </div>
</section>