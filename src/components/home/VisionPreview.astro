---
import SectionHeader from "../common/SectionHeader.astro";
import Button from "../common/Button.astro";

const base = import.meta.env.BASE_URL;

const visionPage = `${base}/vision/`;
const previewImage =
  `${base}/images/vision/interim-results/mixed-pills-02-annotated.jpg`;

const outputs = [
  "Pill type",
  "Object count",
  "Confidence",
  "Object outline",
];
---

<section
  id="technology"
  class="scroll-mt-20 bg-[var(--color-graphite)] py-16 text-white lg:py-28"
>
  <div
    class="
      mx-auto
      grid
      max-w-[1280px]
      grid-cols-1
      gap-12
      px-6
      lg:grid-cols-[0.85fr_1.15fr]
      lg:items-center
      lg:gap-20
      lg:px-10
    "
  >
    <div>
      <SectionHeader
        label="Computer Vision"
        title="Verification before dispensing."
        description="The current visual-inspection prototype identifies pills, produces per-object annotations, and returns confidence information that can be compared with the expected dose before the compartment is allowed to dispense."
        light={true}
      />

      <div class="mt-8 flex flex-wrap gap-2">
        {
          outputs.map((output) => (
            <span
              class="
                rounded-full
                border
                border-white/15
                px-4
                py-2
                text-sm
                text-white/70
              "
            >
              {output}
            </span>
          ))
        }
      </div>

      <div class="mt-8">
        <Button href={visionPage} variant="secondary">
          View Interim Vision Results →
        </Button>
      </div>
    </div>

    <div
      class="
        overflow-hidden
        rounded-[2rem]
        border
        border-white/10
        bg-white
      "
    >
      <img
        src={previewImage}
        alt="Interim computer-vision output showing multiple annotated pill detections"
        loading="lazy"
        class="h-auto w-full"
      />

      <div class="bg-white px-6 py-5 text-[var(--color-text-primary)]">
        <p
          class="
            text-xs
            font-semibold
            uppercase
            tracking-[0.14em]
            text-[var(--color-accent-orange)]
          "
        >
          Interim result
        </p>

        <p
          class="
            mt-2
            text-sm
            leading-6
            text-[var(--color-text-secondary)]
          "
        >
          Annotated detections are development evidence, not yet a formal accuracy benchmark.
        </p>
      </div>
    </div>
  </div>
</section>
