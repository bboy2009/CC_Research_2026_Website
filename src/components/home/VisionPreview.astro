---
import SectionHeader from "../common/SectionHeader.astro";
import Button from "../common/Button.astro";

const base = import.meta.env.BASE_URL;

const visionPage = `${base}/vision/`;
const previewImage =
  `${base}/images/vision/interim-results/mixed-pills-02-annotated.jpg`;

const outputs = [
  "Pill outline",
  "Pill type",
  "Confidence",
  "Pill count",
];
---

<section
  id="technology"
  class="scroll-mt-20 bg-[var(--color-graphite)] py-14 text-white sm:py-16 lg:py-24"
>
  <div
    class="
      mx-auto
      grid
      max-w-[1280px]
      grid-cols-1
      gap-12
      px-6
      lg:grid-cols-[0.85fr_1.15fr]
      lg:items-center
      lg:gap-20
      lg:px-10
    "
  >
    <div>
      <SectionHeader
        label="Computer Vision"
        title="Verification before positioning for pickup."
        description="OpenCV optimizes each image, then OpenAI models outline each pill, identify it with a confidence score, and count the total. The result is compared with the scheduled dose, and the container is moved to Slot L for pickup only if it matches."
        light={true}
      />

      <div class="mt-8 flex flex-wrap gap-2">
        {
          outputs.map((output) => (
            <span
              class="
                rounded-full
                border
                border-white/15
                px-4
                py-2
                text-sm
                text-white/70
              "
            >
              {output}
            </span>
          ))
        }
      </div>

      <div class="mt-8">
        <Button href={visionPage} variant="secondary">
          View Interim Vision Results →
        </Button>
      </div>
    </div>

    <div
      class="
        overflow-hidden
        rounded-[2rem]
        border
        border-white/10
        bg-white
      "
    >
      <img
        src={previewImage}
        alt="Interim AI output showing outlined and identified pills"
        loading="lazy"
        class="h-auto w-full"
      />

      <div class="bg-white px-6 py-5 text-[var(--color-text-primary)]">
        <p
          class="
            text-xs
            font-semibold
            uppercase
            tracking-[0.14em]
            text-[var(--color-accent-orange)]
          "
        >
          Interim result
        </p>

        <p
          class="
            mt-2
            text-sm
            leading-6
            text-[var(--color-text-secondary)]
          "
        >
          Depicted above is an annotated sample from development.
        </p>
      </div>
    </div>
  </div>
</section>
