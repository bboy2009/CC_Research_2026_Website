---
import SectionHeader from "../common/SectionHeader.astro";
import Button from "../common/Button.astro";

const base = import.meta.env.BASE_URL;

const imagePath =
  `${base}/images/product/design-v4b-industrial.jpg`;

const designPage =
  `${base}/design/`;

const facts = [
  { value: "12", label: "Indexed carrier positions" },
  { value: "11", label: "Maximum installed compartments" },
  { value: "30°", label: "Movement per CW / CCW index" },
];
---

<section
  id="design"
  class="scroll-mt-20 py-16 lg:py-28"
>
  <div
    class="
      mx-auto
      grid
      max-w-[1280px]
      grid-cols-1
      items-center
      gap-12
      px-6
      lg:grid-cols-[1.15fr_0.85fr]
      lg:gap-20
      lg:px-10
    "
  >
    <div
      class="
        overflow-hidden
        rounded-[2rem]
        bg-white
        p-6
        lg:p-10
      "
    >
      <img
        src={imagePath}
        alt="Top view of the medicine dispenser rotating carousel"
        class="mx-auto w-full"
      />
    </div>

    <div>
      <SectionHeader
        label="Industrial Design"
        title="A rotating carrier built around removable dose compartments."
        description="The system uses persistent C-ID compartments placed independently within twelve indexed carrier positions. The same physical compartment can be moved to Base Slot A for inspection and Base Slot L for loading or dispensing."
      />

      <div
        class="
          mt-10
          grid
          grid-cols-1
          gap-4
          lg:grid-cols-3
        "
      >
        {
          facts.map((fact) => (
            <div
              class="
                border-t
                border-[var(--color-border)]
                pt-5
              "
            >
              <p
                class="
                  text-3xl
                  font-semibold
                  text-[var(--color-accent-orange)]
                  lg:text-4xl
                "
              >
                {fact.value}
              </p>

              <p
                class="
                  mt-2
                  text-sm
                  leading-6
                  text-[var(--color-text-secondary)]
                "
              >
                {fact.label}
              </p>
            </div>
          ))
        }
      </div>

      <p
        class="
          mt-10
          text-sm
          leading-6
          text-[var(--color-text-secondary)]
        "
      >
        The carrier maintains deterministic indexed positioning relative to HOME, defined as P1 aligned with Base Slot L. At least one rotating position remains empty during normal operation with eleven installed compartments.
      </p>

      <div class="mt-8">
        <Button
          href={designPage}
          variant="secondary"
        >
          Explore Interactive 3D Model →
        </Button>
      </div>
    </div>
  </div>
</section>