---
import SectionHeader from "../common/SectionHeader.astro";
import Button from "../common/Button.astro";

const base = import.meta.env.BASE_URL;

const imagePath =
  `${base}/images/product/design-v4b-industrial.jpg`;

const designPage =
  `${base}/design/`;

const facts = [
  { value: "12", label: "Carrier positions" },
  { value: "11", label: "Maximum containers" },
  { value: "30°", label: "Rotation per step, either direction" },
];
---

<section
  id="design"
  class="scroll-mt-20 py-14 sm:py-14 sm:py-16 lg:py-20"
>
  <div
    class="
      mx-auto
      grid
      max-w-[1280px]
      grid-cols-1
      items-center
      gap-12
      px-6
      lg:grid-cols-[1.15fr_0.85fr]
      lg:gap-20
      lg:px-10
    "
  >
    <div
      class="
        overflow-hidden
        rounded-[2rem]
        bg-white
        p-6
        lg:p-10
      "
    >
      <img
        src={imagePath}
        alt="Top view of the medicine dispenser rotating carousel"
        class="mx-auto w-full"
      />
    </div>

    <div>
      <SectionHeader
        label="Industrial Design"
        title="A carousel to manage the positions of removable medication containers."
        description="Each container is given a unique ID when it is loaded through Slot L into an available carousel position. The carousel then rotates it to Slot A for inspection and keeps it in storage at an available slot until its dose is due."
      />

      <div
        class="
          mt-10
          grid
          grid-cols-1
          gap-4
          lg:grid-cols-3
        "
      >
        {
          facts.map((fact) => (
            <div
              class="
                border-t
                border-[var(--color-border)]
                pt-5
              "
            >
              <p
                class="
                  text-3xl
                  font-semibold
                  text-[var(--color-accent-orange)]
                  lg:text-4xl
                "
              >
                {fact.value}
              </p>

              <p
                class="
                  mt-2
                  text-sm
                  leading-6
                  text-[var(--color-text-secondary)]
                "
              >
                {fact.label}
              </p>
            </div>
          ))
        }
      </div>

      <p
        class="
          mt-10
          text-sm
          leading-6
          text-[var(--color-text-secondary)]
        "
      >
        The dispenser tracks the carousel's home position (P1) and which container is in each position, so it always knows where every container is. One position is always kept empty, so a container can only be reached at Slot L during loading or pickup.
      </p>

      <div class="mt-8">
        <Button
          href={designPage}
          variant="secondary"
        >
          Explore Interactive 3D Model →
        </Button>
      </div>
    </div>
  </div>
</section>