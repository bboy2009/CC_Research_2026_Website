---
interface Props {
  imagePath: string;
  label: string;
  title: string;
  description: string;
  details: string[];
}

const {
  imagePath,
  label,
  title,
  description,
  details,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const imageSrc = `${base}${imagePath.startsWith("/") ? imagePath : `/${imagePath}`}`;
---

<article
  class="
    overflow-hidden
    rounded-[2rem]
    border
    border-[var(--color-border)]
    bg-white
  "
>
  <div class="border-b border-[var(--color-border)] bg-black/[0.02]">
    <img
      src={imageSrc}
      alt={title}
      loading="lazy"
      class="h-auto w-full"
    />
  </div>

  <div class="p-6 lg:p-8">
    <p
      class="
        text-xs
        font-semibold
        uppercase
        tracking-[0.16em]
        text-[var(--color-accent-orange)]
      "
    >
      {label}
    </p>

    <h2 class="mt-3 text-2xl font-semibold">
      {title}
    </h2>

    <p
      class="
        mt-4
        leading-7
        text-[var(--color-text-secondary)]
      "
    >
      {description}
    </p>

    <ul
      class="
        mt-6
        space-y-3
        text-sm
        leading-6
        text-[var(--color-text-secondary)]
      "
    >
      {
        details.map((detail) => (
          <li class="flex gap-3">
            <span
              class="mt-[0.55rem] h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-accent-teal)]"
              aria-hidden="true"
            ></span>
            <span>{detail}</span>
          </li>
        ))
      }
    </ul>
  </div>
</article>
