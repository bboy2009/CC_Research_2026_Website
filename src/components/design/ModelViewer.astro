---
const base = import.meta.env.BASE_URL;

const modelPath =
  `${base}/models/medicine-dispenser.glb`;

const posterPath =
  `${base}/images/product/design-01.jpg`;
---

<div
  class="
    overflow-hidden
    rounded-[2rem]
    border
    border-[var(--color-border)]
    bg-white
  "
>
  <div
    class="
      flex
      items-center
      justify-between
      border-b
      border-[var(--color-border)]
      px-6
      py-4
    "
  >
    <div>
      <p class="font-medium">
        Interactive Device Model
      </p>

      <p
        class="
          mt-1
          text-sm
          text-[var(--color-text-secondary)]
        "
      >
        Drag to rotate. Scroll or pinch to zoom.
      </p>
    </div>

    <span
      class="
        hidden
        rounded-full
        bg-[var(--color-background)]
        px-4
        py-2
        text-xs
        font-semibold
        uppercase
        tracking-[0.12em]
        text-[var(--color-text-secondary)]
        lg:inline-flex
      "
    >
      Interactive 3D
    </span>
  </div>

  <model-viewer
    id="medicine-model"

    src={modelPath}
    poster={posterPath}

    alt="Interactive 3D model of the medicine dispensing device prototype"

    camera-controls
    touch-action="pan-y"

    auto-rotate
    auto-rotate-delay="1500"
    rotation-per-second="12deg"

    shadow-intensity="1"
    shadow-softness="1"

    exposure="1"

    interaction-prompt="auto"

    loading="eager"
    reveal="auto"

    min-camera-orbit="auto auto 30%"
    max-camera-orbit="auto auto 250%"

    class="device-model"
  >
  </model-viewer>
</div>

<script>
  import "@google/model-viewer";

  console.log("[ModelViewer] client script loaded");

  customElements
    .whenDefined("model-viewer")
    .then(() => {
      console.log(
        "[ModelViewer] custom element registered"
      );

      const viewer =
        document.querySelector("#medicine-model");

      if (!viewer) {
        console.warn(
          "[ModelViewer] model-viewer element not found"
        );

        return;
      }

      console.log(
        "[ModelViewer] model-viewer element found"
      );

      console.log(
        "[ModelViewer] camera-controls:",
        viewer.hasAttribute("camera-controls")
      );

      viewer.addEventListener(
        "load",
        () => {
          console.log(
            "[ModelViewer] GLB model loaded"
          );
        }
      );

      viewer.addEventListener(
        "error",
        (event) => {
          console.error(
            "[ModelViewer] model loading error:",
            event
          );
        }
      );
    });
</script>

<style>
  .device-model {
    display: block;

    width: 100%;
    height: 430px;

    cursor: grab;

    background:
      radial-gradient(
        circle at center,
        #ffffff 0%,
        #f5f2ea 100%
      );

    --poster-color: transparent;
  }

  .device-model:active {
    cursor: grabbing;
  }

  @media (min-width: 1024px) {
    .device-model {
      height: 680px;
    }
  }
</style>