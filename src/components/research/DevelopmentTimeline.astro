---
import StatusBadge from "./StatusBadge.astro";

const stages = [
  {
    number: "01",
    title: "Requirements Baseline",
    status: "DOCUMENTED BASELINE" as const,
    description:
      "Product and system requirements define the removable-compartment concept, prescription-driven scheduling, grouped dispense events, safety boundaries, and target operational workflows.",
    artifact:
      "Product Requirements v1.6 and System Requirements v1.3",
  },
  {
    number: "02",
    title: "Industrial Design",
    status: "INTERIM RESULT" as const,
    description:
      "The rotating carrier, removable compartments, fixed inspection and access locations, retention concept, and physical interaction sequence have been developed as an integrated design direction.",
    artifact:
      "Industrial design renders, interaction videos, and interactive 3D models",
  },
  {
    number: "03",
    title: "Software & System Architecture",
    status: "INTERIM RESULT" as const,
    description:
      "The software architecture separates application workflows, persistence, vision, device control, and embedded-controller responsibilities while preserving explicit compartment identity and placement state.",
    artifact:
      "Python prototype implementation and system architecture diagrams",
  },
  {
    number: "04",
    title: "Computer Vision Exploration",
    status: "INTERIM RESULT" as const,
    description:
      "Development work explores pill localization, classification, counting, annotation, and structured verification outcomes under single-pill and mixed-pill scenes.",
    artifact:
      "Annotated inspection examples and vision workflow implementation",
  },
  {
    number: "05",
    title: "Integrated Product Showcase",
    status: "INTERIM RESULT" as const,
    description:
      "The current website brings the product concept, user workflow, industrial design, software architecture, and implementation evidence into one coherent engineering narrative.",
    artifact:
      "Responsive MediSAFE prototype website through Milestone 12",
  },
  {
    number: "06",
    title: "Integrated Prototype Validation",
    status: "PLANNED VALIDATION" as const,
    description:
      "Next-stage work will combine mechanical, sensing, embedded-control, computer-vision, scheduling, recovery, and end-to-end workflow testing against defined acceptance evidence.",
    artifact:
      "Planned integrated verification and acceptance program",
  },
];
---

<div class="mt-10 space-y-4 lg:mt-12">
  {
    stages.map((stage, index) => (
      <article
        class="
          grid
          grid-cols-[auto_1fr]
          gap-5
          rounded-3xl
          border
          border-[var(--color-border)]
          bg-white
          p-6
          lg:grid-cols-[90px_1fr_auto]
          lg:items-start
          lg:gap-8
          lg:p-8
        "
      >
        <div>
          <div
            class="
              flex
              h-12
              w-12
              items-center
              justify-center
              rounded-full
              bg-[var(--color-background)]
              text-sm
              font-semibold
              text-[var(--color-accent-orange)]
            "
          >
            {stage.number}
          </div>

          {
            index < stages.length - 1 && (
              <div
                class="
                  mx-auto
                  mt-3
                  hidden
                  h-12
                  w-px
                  bg-[var(--color-border)]
                  lg:block
                "
              />
            )
          }
        </div>

        <div>
          <div class="flex flex-wrap items-center gap-3">
            <h3 class="text-lg font-semibold sm:text-xl lg:text-2xl">
              {stage.title}
            </h3>

            <div class="lg:hidden">
              <StatusBadge status={stage.status} />
            </div>
          </div>

          <p
            class="
              mt-3
              max-w-[780px]
              text-sm
              leading-6
              text-[var(--color-text-secondary)]
              sm:text-base
              sm:leading-7
            "
          >
            {stage.description}
          </p>

          <p
            class="
              mt-4
              text-sm
              leading-6
              text-[var(--color-text-secondary)]
            "
          >
            <span class="font-semibold text-[var(--color-text-primary)]">
              Current artifact:
            </span>
            {" "}
            {stage.artifact}
          </p>
        </div>

        <div class="hidden lg:block">
          <StatusBadge status={stage.status} />
        </div>
      </article>
    ))
  }
</div>
