---
interface Props {
  desktopPath: string;
  mobilePath: string;
  alt: string;
  caption?: string;
  eager?: boolean;
}

const {
  desktopPath,
  mobilePath,
  alt,
  caption,
  eager = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;

const withBase = (path: string) =>
  `${base}${path.startsWith("/") ? path : `/${path}`}`;

const desktopSrc = withBase(desktopPath);
const mobileSrc = withBase(mobilePath);
---

<figure>
  <div
    class="
      overflow-hidden
      rounded-[2rem]
      border
      border-[var(--color-border)]
      bg-white
      p-2
      lg:p-6
    "
  >
    <picture>
      <source
        media="(min-width: 1024px)"
        srcset={desktopSrc}
      />

      <img
        src={mobileSrc}
        alt={alt}
        loading={eager ? "eager" : "lazy"}
        class="h-auto w-full"
      />
    </picture>
  </div>

  {
    caption && (
      <figcaption
        class="
          mt-3
          px-2
          text-sm
          leading-6
          text-[var(--color-text-secondary)]
        "
      >
        {caption}
      </figcaption>
    )
  }
</figure>
