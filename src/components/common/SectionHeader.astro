---
interface Props {
  label: string;
  title: string;
  description?: string;
  light?: boolean;
}

const {
  label,
  title,
  description,
  light = false,
} = Astro.props;
---

<div>
  <p
    class:list={[
      "text-sm font-semibold uppercase tracking-[0.18em]",
      light
        ? "text-[var(--color-accent-teal)]"
        : "text-[var(--color-accent-orange)]",
    ]}
  >
    {label}
  </p>

  <h2
    class:list={[
      "mt-3 max-w-[850px] text-2xl font-semibold leading-[1.15] tracking-tight sm:mt-4 sm:text-3xl lg:text-4xl",
      light ? "text-white" : "text-[var(--color-text-primary)]",
    ]}
  >
    {title}
  </h2>

  {
    description && (
      <p
        class:list={[
          "mt-4 max-w-[760px] text-base leading-7 sm:mt-5 lg:text-[1.0625rem] lg:leading-8",
          light
            ? "text-white/70"
            : "text-[var(--color-text-secondary)]",
        ]}
      >
        {description}
      </p>
    )
  }
</div>
