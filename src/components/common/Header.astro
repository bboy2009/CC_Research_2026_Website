---
const base = import.meta.env.BASE_URL;

const withBase = (path: string) =>
  `${base}${path.startsWith("/") ? path : `/${path}`}`;

const navigation = [
  {
    label: "Product",
    href: withBase("/product/"),
  },
  {
    label: "How It Works",
    href: withBase("/how-it-works/"),
  },
  {
    label: "Design",
    href: withBase("/design/"),
  },
  {
    label: "Technology",
    href: withBase("/technology/"),
  },
  {
    label: "Research",
    href: withBase("/research/"),
  },
];
---

<header
  class="
    sticky
    top-0
    z-50
    border-b
    border-black/5
    bg-[var(--color-background)]/95
    backdrop-blur
  "
>
  <div
    class="
      mx-auto
      flex
      h-20
      max-w-[1280px]
      items-center
      justify-between
      px-6
      lg:px-10
    "
  >
    <a
      href={withBase("/")}
      class="font-semibold tracking-tight"
    >
      Medication Dispenser
    </a>

    <!-- Desktop navigation -->
    <nav
      class="
        hidden
        items-center
        gap-8
        text-sm
        font-medium
        lg:flex
      "
      aria-label="Primary navigation"
    >
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class="
              transition
              hover:text-[var(--color-accent-orange)]
            "
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Mobile navigation -->
    <details class="relative lg:hidden">
      <summary
        class="
          flex
          h-11
          w-11
          cursor-pointer
          list-none
          items-center
          justify-center
          rounded-full
          border
          border-[var(--color-border)]
          text-xl
        "
        aria-label="Open navigation menu"
      >
        ☰
      </summary>

      <nav
        class="
          absolute
          right-0
          top-14
          w-64
          overflow-hidden
          rounded-2xl
          border
          border-[var(--color-border)]
          bg-white
          shadow-xl
        "
        aria-label="Mobile navigation"
      >
        {
          navigation.map((item) => (
            <a
              href={item.href}
              class="
                block
                border-b
                border-black/5
                px-6
                py-4
                font-medium
                last:border-b-0
              "
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>