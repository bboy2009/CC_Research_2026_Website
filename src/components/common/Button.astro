---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
}

const {
  href,
  variant = "primary",
} = Astro.props;

const baseClasses =
  "inline-flex min-h-12 items-center justify-center rounded-full px-7 font-medium transition";

const variantClasses = {
  primary:
    "bg-[var(--color-graphite)] text-white hover:opacity-90",
  secondary:
    "border border-[var(--color-border)] bg-white text-[var(--color-text-primary)] hover:bg-black/5",
};
---

<a
  href={href}
  class={`${baseClasses} ${variantClasses[variant]}`}
>
  <slot />
</a>