---
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "MediSAFE: Medication Dispenser",
  description =
    "MediSAFE is an engineering prototype for prescription-driven scheduling, visual medication verification, removable dose compartments, controlled dispensing, and separate pickup tracking.",
} = Astro.props;

const favicon =
  `${import.meta.env.BASE_URL}/favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#f5f2ea"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href={favicon}
    />
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>